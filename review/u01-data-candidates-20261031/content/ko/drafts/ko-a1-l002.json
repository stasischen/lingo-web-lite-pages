          "segments": ["마이클\tko:prop:마이클", "씨,\tko:count:씨", "직업은\tko:n:직업+ko:p:은", "뭐예요?\tko:pron:뭐+ko:cop:이다+ko:e:에요"]
        },
        {
          "speaker": "마이클",
          "korean": "대학원생이에요. 한국 역사를 공부해요.",
          "translation": "我是研究生。在學韓國歷史。",
          "segments": ["대학원생이에요.\tko:n:대학원생+ko:cop:이다+ko:e:에요", "한국\tko:prop:한국", "역사를\tko:n:역사+ko:p:를", "공부해요.\tko:n:공부+ko:v:하다+ko:e:어요"]
        },
        {
          "speaker": "소라",
          "korean": "네, 여기 이름하고 직업을 적었어요. 이름표 받으세요.",
          "translation": "好，這裡寫了名字和職業。請拿名牌。",
          "segments": ["네,\tko:intj:네", "여기\tko:pron:여기", "이름하고\tko:n:이름+ko:p:하고", "직업을\tko:n:직업+ko:p:을", "적었어요.\tko:v:적다+ko:e:었+ko:e:어요", "이름표\tko:n:이름표", "받으세요.\tko:v:받다+ko:e:으세요"]
        },
        {
          "speaker": "마이클",
          "korean": "감사합니다. 수업은 어디에서 해요?",
          "translation": "謝謝。在哪裡上課呢？",
          "segments": ["감사합니다.\tko:intj:감사합니다", "수업은\tko:n:수업+ko:p:은", "어디에서\tko:pron:어디+ko:p:에서", "해요?\tko:v:하다+ko:e:어요"]
        },
        {
          "speaker": "소라",
          "korean": "바로 옆 교실이에요. 같이 가요.",
          "translation": "就在隔壁教室。一起走吧。",
          "segments": ["바로\tko:adv:바로", "옆\tko:n:옆", "교실이에요.\tko:n:교실+ko:cop:이다+ko:e:에요", "같이\tko:adv:같이", "가요.\tko:v:가다+ko:e:아요"]
        }
      ]
    },
    {
      "id": "D2",
      "title": "D2",
      "location": "未拆分",
      "context": "同一天下課後，中心旁的咖啡館。",
