    {
      "id": "D1",
      "title": "D1",
      "location": "未拆分",
      "context": "週四上課前，中心櫃檯。",
      "purpose": "登記마이클的姓名與職業，並製作名牌。",
      "turns": [
        {
          "speaker": "소라",
          "korean": "안녕하세요. 오늘 처음 오셨죠?",
