          "segments": ["좋아요.\tko:adj:좋다+ko:e:아요", "거기서\tko:pron:거기+ko:p:서", "같이\tko:adv:같이", "음악도\tko:n:음악+ko:p:도", "들어요.\tko:v:듣다+ko:e:어요"]
