          "segments": ["마이클\tko:prop:마이클", "씨는\tko:count:씨+ko:p:는", "쉬는\tko:v:쉬다+ko:e:는", "날에\tko:n:날+ko:p:에", "뭐\tko:pron:뭐", "해요?\tko:v:하다+ko:e:어요"]
