  "dialogue": [
    {
      "id": "scene.d1",
      "title": "D1 · 週日上午，이안和애니在十字路口看社區地圖看板，準備去公園散步。",
      "location": "週日上午，이안和애니在十字路口看社區地圖看板，準備去公園散步。",
      "context": "週日上午在十字路口，怡安和安妮看著社區地圖看板，確認去公園的位置與走法。",
      "purpose": "用地圖確認公園的位置和走法。",
      "turns": [
        {
          "speaker": "怡安",
          "korean": "언니, 공원은 어디에 있어요?",
          "translation": "姊姊，公園在哪裡？"
        },
        {
          "speaker": "安妮",
          "korean": "여기 봐요. 공원은 도서관 옆에 있어요.",
          "translation": "看這裡。公園在圖書館旁邊。"
        },
        {
          "speaker": "怡安",
          "korean": "우리는 지금 어디에 있어요?",
          "translation": "我們現在在哪裡？"
        },
        {
          "speaker": "安妮",
          "korean": "여기요. 이 사거리예요.",
          "translation": "這裡。就是這個十字路口。"
        },
        {
          "speaker": "怡安",
          "korean": "그럼 앞으로 쭉 가요?",
          "translation": "那一直往前走嗎？"
        },
        {
          "speaker": "安妮",
          "korean": "네. 도서관 앞에서 오른쪽으로 가요.",
          "translation": "對。在圖書館前面往右走。"
        },
        {
          "speaker": "怡安",
          "korean": "공원 입구가 여기예요?",
          "translation": "公園入口在這裡嗎？"
        },
        {
          "speaker": "安妮",
          "korean": "네, 맞아요. 같이 가요.",
          "translation": "對，沒錯。一起走吧。"
        }
      ]
    },
    {
      "id": "scene.d2",
      "title": "D2 · 白天，訪客在公共設施的服務台詢問洗手間的位置，和工作人員一起看旁邊的簡單平面圖。",
      "location": "白天，訪客在公共設施的服務台詢問洗手間的位置，和工作人員一起看旁邊的簡單平面圖。",
      "context": "白天在公共設施服務台，訪客詢問洗手間的位置，並和工作人員一起看平面圖確認方向。",
      "purpose": "看平面圖確認洗手間的位置和方向。",
      "turns": [
        {
          "speaker": "訪客",
          "korean": "저기요, 화장실은 어디에 있어요?",
          "translation": "不好意思，請問洗手間在哪裡？"
        },
        {
          "speaker": "工作人員",
          "korean": "이 안내도를 보세요. 여기가 입구예요. 화장실은 오른쪽 복도 끝에 있어요.",
          "translation": "請看這張平面圖。這裡是入口。洗手間在右邊走廊的盡頭。"
        },
        {
          "speaker": "訪客",
          "korean": "오른쪽 복도 끝에 있어요?",
          "translation": "在右邊走廊的盡頭嗎？"
        },
        {
          "speaker": "工作人員",
          "korean": "네, 맞아요.",
          "translation": "對，沒錯。"
        },
        {
          "speaker": "訪客",
          "korean": "감사합니다.",
          "translation": "謝謝。"
        }
      ]
    },
    {
      "id": "scene.d3",
      "title": "D3 · 晚上，全員在밥집吃送別晚餐；飯後，도현拿出附有社區地圖的〈동네 안내〉傳單。",
      "location": "晚上，全員在밥집吃送別晚餐；飯後，도현拿出附有社區地圖的〈동네 안내〉傳單。",
      "context": "晚上大家在小餐館吃送別晚餐，飯後道賢拿出社區地圖傳單，眾人標記位置、歸還橡皮擦並合照道別。",
      "purpose": "在地圖上標記下次來訪的位置，歸還借來的橡皮擦並拍合照道別。",
      "turns": [
        {
          "speaker": "素拉",
          "korean": "어머니, 안녕하세요. 여기 앉으세요.",
          "translation": "媽媽，您好。請坐這裡。"
        },
        {
          "speaker": "媽媽",
          "korean": "안녕하세요.",
          "translation": "您好。"
        },
        {
          "speaker": "道賢",
          "korean": "이 동네 지도 가져가세요. 다음에 또 오세요.",
          "translation": "這張社區地圖請帶回去。下次再來喔。"
        },
        {
          "speaker": "怡安",
          "korean": "네, 지도에 이 밥집을 표시할게요.",
          "translation": "好，我把這家店標在地圖上。"
        },
        {
          "speaker": "道賢",
          "korean": "이 밥집은 공원 맞은편에 있어요. 지도에서 여기예요.",
          "translation": "這家店在公園對面。在地圖上的這裡。"
        },
        {
          "speaker": "怡安",
          "korean": "여기에 동그라미를 칠게요. 다음에는 제가 찾을게요.",
          "translation": "我在這裡圈起來。下次換我來找。"
        },
        {
          "speaker": "安妮",
          "korean": "유키 씨, 지우개 돌려줄게요. 잘 썼어요.",
          "translation": "由紀，橡皮擦還你。很好用，謝謝。"
        },
        {
          "speaker": "由紀",
          "korean": "아, 제 지우개네요. 고마워요.",
          "translation": "啊，是我的橡皮擦。謝謝你。"
        },
        {
          "speaker": "素拉",
          "korean": "그럼 다 같이 사진 찍어요.",
          "translation": "那大家一起拍張照吧。"
        },
        {
          "speaker": "道賢",
          "korean": "휴대폰을 저 테이블에 놓을게요. 타이머를 맞췄어요. 다 같이 찍을 수 있어요.",
          "translation": "我把手機放在那張桌子上。我設了定時器，大家可以一起拍。"
        },
        {
          "speaker": "由紀",
          "korean": "저는 앞에 설게요.",
          "translation": "我站前面。"
        },
        {
          "speaker": "麥可",
          "korean": "그럼 저는 이안 씨랑 뒤에 설게요.",
          "translation": "那我和怡安站後面。"
        },
        {
          "speaker": "怡安",
          "korean": "네. 언니, 엄마랑 앞에 서요.",
          "translation": "好。姊姊，和媽媽站前面。"
        },
        {
          "speaker": "素拉",
          "korean": "어머니, 여기 보세요.",
          "translation": "媽媽，看這裡。"
        },
        {
          "speaker": "道賢",
          "korean": "자, 찍어요. 하나, 둘, 셋!",
          "translation": "來，要拍囉。一、二、三！"
        },
        {
          "speaker": "怡安",
          "korean": "모두 고마워요. 또 만나요!",
          "translation": "謝謝大家。下次再見！"
        }
      ]
    }
  ],
