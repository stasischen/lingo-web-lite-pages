  "dialogue": [
    {
      "id": "scene.d1",
      "title": "D1 · 週六，中心的語言交換活動中。",
      "location": "週六，中心的語言交換活動中。",
      "context": "週六在中心的語言交換活動中，安妮向麥可借原子筆，獲得同意並接過筆。",
      "purpose": "애니向마이클借原子筆，獲得同意並接過筆。",
      "turns": [
        {
          "speaker": "安妮",
          "korean": "마이클 씨, 볼펜 좀 빌려 주세요.",
          "translation": "麥可，借我一下原子筆。"
        },
        {
          "speaker": "麥可",
          "korean": "네, 여기요. 이거 쓰세요.",
          "translation": "好，給你。用這支吧。"
        },
        {
          "speaker": "安妮",
          "korean": "고마워요. 잠깐만 쓸게요.",
          "translation": "謝謝，我用一下就好。"
        },
        {
          "speaker": "麥可",
          "korean": "네, 괜찮아요.",
          "translation": "好，沒關係。"
        },
        {
          "speaker": "安妮",
          "korean": "다 썼어요. 여기요. 고마워요.",
          "translation": "我用好了。還你。謝謝。"
        },
        {
          "speaker": "麥可",
          "korean": "네.",
          "translation": "好。"
        }
      ]
    },
    {
      "id": "scene.d2",
      "title": "D2 · 咖啡館裡，三人正在參加讀書會。",
      "location": "咖啡館裡，三人正在參加讀書會。",
      "context": "咖啡館裡三人正在參加讀書會，安妮向由紀借橡皮擦，等由紀用完後接過橡皮擦並致謝。",
      "purpose": "애니向유키借橡皮擦，等유키用完後接過橡皮擦並致謝。",
      "turns": [
        {
          "speaker": "安妮",
          "korean": "유키 씨, 지우개 좀 빌려 주세요.",
          "translation": "由紀，借我一下橡皮擦。"
        },
        {
          "speaker": "由紀",
          "korean": "미안해요. 지금 쓰고 있어요.",
          "translation": "抱歉，我現在在用。"
        },
        {
          "speaker": "安妮",
          "korean": "네, 기다릴게요.",
          "translation": "好，我等你。"
        },
        {
          "speaker": "由紀",
          "korean": "다 썼어요. 여기요.",
          "translation": "我用好了，給你。"
        },
        {
          "speaker": "安妮",
          "korean": "고마워요.",
          "translation": "謝謝。"
        }
      ]
    },
    {
      "id": "scene.d3",
      "title": "D3 · 白天，애니在文具店想看高處架上的筆記本。",
      "location": "白天，애니在文具店想看高處架上的筆記本。",
      "context": "白天安妮在文具店想看高處架上的筆記本，請店員幫忙拿筆記本，店員拿給了她。",
      "purpose": "애니請店員幫忙拿筆記本，店員拿給她。",
      "turns": [
        {
          "speaker": "安妮",
          "korean": "저기요. 저 위에 있는 공책 좀 꺼내 주세요.",
          "translation": "不好意思，請幫我拿一下上面那本筆記本。"
        },
        {
          "speaker": "店員",
          "korean": "이 파란 공책이요?",
          "translation": "這本藍色的嗎？"
        },
        {
          "speaker": "安妮",
          "korean": "네. 너무 높아요.",
          "translation": "對，太高了。"
        },
        {
          "speaker": "店員",
          "korean": "여기 있어요. 한번 보세요.",
          "translation": "在這裡，你看一下。"
        },
        {
          "speaker": "安妮",
          "korean": "네, 고맙습니다.",
          "translation": "好，謝謝。"
        }
      ]
    }
