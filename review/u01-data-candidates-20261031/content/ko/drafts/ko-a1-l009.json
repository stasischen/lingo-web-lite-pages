  "dialogue": [
    {
      "id": "scene.d1",
      "title": "D1 · 週二，教室裡，소라拿著週六語言交換活動的照片，讓大家猜照片裡的人。",
      "location": "週二，教室裡，소라拿著週六語言交換活動的照片，讓大家猜照片裡的人。",
      "context": "週二在教室裡，素拉拿著週六語言交換活動的照片，讓大家只看背影猜猜照片裡的人。",
      "purpose": "從背影猜出照片裡的도현。",
      "turns": [
        {
          "speaker": "素拉",
          "korean": "자, 다음 사진이에요. 뒷모습만 보고 맞혀 보세요.",
          "translation": "來，這是下一張照片。大家只看背影猜猜看吧。"
        },
        {
          "speaker": "安妮",
          "korean": "키가 크고 머리가 짧아요. 마이클 씨예요?",
          "translation": "個子很高，頭髮很短。是麥可嗎？"
        },
        {
          "speaker": "麥可",
          "korean": "저는 아니에요. 저는 사진 오른쪽에 있어요.",
          "translation": "不是我。我在照片右邊。"
        },
        {
          "speaker": "由紀",
          "korean": "도현 씨도 키가 커요. 도현 씨예요?",
          "translation": "道賢個子也很高。是道賢嗎？"
        },
        {
          "speaker": "素拉",
          "korean": "맞아요. 이제 얼굴도 보세요.",
          "translation": "沒錯。現在來看看正面吧。"
        },
        {
          "speaker": "安妮",
          "korean": "아, 도현 씨예요!",
          "translation": "啊，是道賢！"
        }
      ]
    },
    {
      "id": "scene.d2",
      "title": "D2 · 週五晚上，仁川機場入境大廳，애니和도현等來首爾探訪的妹妹與母親出來。",
      "location": "週五晚上，仁川機場入境大廳，애니和도현等來首爾探訪的妹妹與母親出來。",
      "context": "週五晚上在仁川機場入境大廳，安妮和道賢等著來首爾探訪的妹妹與媽媽出來，並順利接到兩人。",
      "purpose": "辨認妹妹和母親，順利接到兩人。",
      "turns": [
        {
          "speaker": "道賢",
          "korean": "사람이 많네요. 동생이 보여요?",
          "translation": "人真多。看到妹妹了嗎？"
        },
        {
          "speaker": "安妮",
          "korean": "네. 저기요! 제 여동생은 키가 커요.",
          "translation": "看到了。在那裡！我妹妹個子很高。"
        },
        {
          "speaker": "道賢",
          "korean": "흰 셔츠 입은 분이에요?",
          "translation": "是穿白襯衫的那位嗎？"
        },
        {
          "speaker": "安妮",
          "korean": "네. 옆에 계신 분이 저희 어머니예요.",
          "translation": "對。旁邊那位是我媽媽。"
        },
        {
          "speaker": "道賢",
          "korean": "아, 두 분이 같이 오시네요.",
          "translation": "啊，兩位一起走過來了。"
        },
        {
          "speaker": "安妮",
          "korean": "엄마! 이안! 여기예요!",
          "translation": "媽！怡安！這裡！"
        },
        {
          "speaker": "怡安",
          "korean": "언니!",
          "translation": "姊姊！"
        },
        {
          "speaker": "安妮",
          "korean": "이분은 도현 씨예요.",
          "translation": "這位是道賢。"
        },
        {
          "speaker": "道賢",
          "korean": "안녕하세요. 반가워요.",
          "translation": "你好，很高興認識你。"
        },
        {
          "speaker": "怡安",
          "korean": "안녕하세요. 언니한테 얘기 많이 들었어요.",
          "translation": "你好。常聽姊姊提起你。"
        },
        {
          "speaker": "媽媽",
          "korean": "안녕하세요.",
          "translation": "你好。"
        },
        {
          "speaker": "安妮",
          "korean": "이안아, 언니가 짐 들어 줄게요.",
          "translation": "怡安，姊姊幫你拿行李。"
        }
      ]
    },
    {
      "id": "scene.d3",
      "title": "D3 · 週六，밥집的歡迎晚餐上，유키拿出家人照片。",
      "location": "週六，밥집的歡迎晚餐上，유키拿出家人照片。",
      "context": "週六在飯館的歡迎晚餐上，由紀拿出家人的照片，向大家介紹自己的家人。",
      "purpose": "透過照片認識유키的家人，分清哥哥和丈夫。",
      "turns": [
        {
          "speaker": "由紀",
          "korean": "안녕하세요. 만나서 반가워요.",
          "translation": "你們好，很高興見到你們。"
        },
        {
          "speaker": "媽媽",
          "korean": "안녕하세요.",
          "translation": "你好。"
        },
        {
          "speaker": "怡安",
          "korean": "안녕하세요. 아, 가족 사진이에요?",
          "translation": "你好。啊，是家人的照片嗎？"
        },
        {
          "speaker": "由紀",
          "korean": "네. 같이 볼래요?",
          "translation": "對啊。要一起看嗎？"
        },
        {
          "speaker": "怡安",
          "korean": "네. 유키 씨는 어디 있어요?",
          "translation": "好啊。由紀在哪裡？"
        },
        {
          "speaker": "由紀",
          "korean": "여기요. 저는 키가 작아요.",
          "translation": "這裡。我個子比較矮。"
        },
        {
          "speaker": "怡安",
          "korean": "아, 여기요! 옆에 계신 분은 오빠예요?",
          "translation": "啊，在這裡！旁邊那位是哥哥嗎？"
        },
        {
          "speaker": "由紀",
          "korean": "아니요, 제 남편이에요. 오빠는 여기 있어요.",
          "translation": "不是，是我先生。哥哥在這裡。"
        },
        {
          "speaker": "道賢",
          "korean": "음식 나왔어요. 따뜻할 때 드세요.",
          "translation": "菜來了。趁熱吃吧。"
        },
        {
          "speaker": "怡安",
          "korean": "감사합니다. 유키 씨, 밥 먹고 사진 더 봐도 돼요?",
          "translation": "謝謝。由紀，吃完飯還可以再看照片嗎？"
        },
        {
          "speaker": "由紀",
          "korean": "네. 밥 먹고 같이 봐요.",
          "translation": "好啊。吃完飯我們再一起看。"
        }
      ]
    }
  ],
