  "dialogue": [
    {
      "id": "scene.d1",
      "title": "D1 · 週二 18:55，下雨的中心大門口",
      "location": "週二 18:55，下雨的中心大門口",
      "context": "週二 18:55 在下雨的中心大門口，素拉照著名單迎接新生，確認身分並第一次問候。",
      "purpose": "소라照名單迎接新生，確認身分並第一次問候。",
      "turns": [
        {
          "speaker": "素拉",
          "korean": "안녕하세요? 혹시 천이쥔 씨예요?",
          "translation": "你好，請問是陳怡君嗎？"
        },
        {
          "speaker": "安妮",
          "korean": "네, 맞아요. 애니라고 불러 주세요. 안녕하세요?",
          "translation": "對，沒錯。叫我安妮就好。你好！"
        },
        {
          "speaker": "素拉",
          "korean": "반갑습니다, 애니 씨. 저는 한국어 선생님 소라예요. 비가 많이 와요. 안으로 들어오세요.",
          "translation": "很高興認識妳，安妮。我是韓語老師素拉。雨下得很大，快請進。"
        },
        {
          "speaker": "安妮",
          "korean": "네, 감사합니다. 오늘 잘 부탁드려요!",
          "translation": "好的，謝謝。今天請多指教！"
        }
      ]
    },
    {
      "id": "scene.d2",
      "title": "D2 · 週二晚間，教室裡的第一堂課",
      "location": "週二晚間，教室裡的第一堂課",
      "context": "週二晚間在教室裡的第一堂課，大家輪流做包含名字、國家與職業的完整自我介紹。",
      "purpose": "輪流做完整自我介紹（名字、國家、職業）。",
      "turns": [
        {
          "speaker": "素拉",
          "korean": "여러분, 환영해요. 저는 한국어 선생님 소라예요. 한국 사람이에요. 유키 씨 먼저 인사해요.",
          "translation": "歡迎大家。我是韓語老師素拉，是韓國人。由紀先打招呼吧。"
        },
        {
          "speaker": "由紀",
          "korean": "네. 안녕하세요? 저는 유키예요. 일본 사람이에요. 병원 간호사예요.",
          "translation": "好。大家好，我是由紀，是日本人，在醫院當護理師。"
        },
        {
          "speaker": "素拉",
          "korean": "반갑습니다, 유키 씨. 애니 씨는요?",
          "translation": "很高興認識你，由紀。安妮呢？"
        },
        {
          "speaker": "安妮",
          "korean": "안녕하세요? 제 이름은 애니예요. 대만 사람이에요. 저는 회사원이에요.",
          "translation": "大家好，我的名字是安妮，是台灣人，我是上班族。"
        }
      ]
    },
    {
      "id": "scene.d3",
      "title": "D3 · 下課後，地鐵站出口",
      "location": "下課後，地鐵站出口",
      "context": "下課後在地鐵站出口，安妮向由紀核對剛才認識的人，由紀為她說明更正。",
      "purpose": "애니回想剛才認識的人，向유키核對，유키更正。",
      "turns": [
        {
          "speaker": "安妮",
          "korean": "오늘 수업 재미있었어요, 유키 씨.",
          "translation": "由紀，今天的課很有趣。"
        },
        {
          "speaker": "由紀",
          "korean": "네, 저도요.",
          "translation": "對啊，我也覺得。"
        },
        {
          "speaker": "安妮",
          "korean": "그런데... 유키 씨는 회사원이에요?",
          "translation": "不過……由紀是上班族嗎？"
        },
        {
          "speaker": "由紀",
          "korean": "아니요, 저는 간호사예요.",
          "translation": "不是，我是護理師。"
        },
        {
          "speaker": "安妮",
          "korean": "아, 맞아요! 제가 깜빡했어요.",
          "translation": "啊，對耶！我一時忘了。"
        },
        {
          "speaker": "由紀",
          "korean": "괜찮아요. 다음 주에 봐요!",
          "translation": "沒關係，下週見！"
        },
        {
          "speaker": "安妮",
          "korean": "네, 다음 주에 봐요!",
          "translation": "好，下週見！"
        }
      ]
    }
  ],
