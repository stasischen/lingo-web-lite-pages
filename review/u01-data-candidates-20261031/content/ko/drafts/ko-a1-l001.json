  "dialogue": [
    {
      "id": "D1",
      "title": "D1",
      "location": "未拆分",
      "context": "週二 18:55，下雨的中心大門口",
      "purpose": "소라照名單迎接新生，確認身分並第一次問候。",
      "turns": [
        {
          "speaker": "소라",
          "korean": "안녕하세요? 혹시 천이쥔 씨예요?",
          "translation": "你好，請問是陳怡君嗎？",
          "segments": ["안녕하세요?\tko:adj:안녕하다+ko:e:세요", "혹시\tko:adv:혹시", "천이쥔\tko:prop:천이쥔", "씨예요?\tko:count:씨+ko:cop:이다+ko:e:에요"]
        },
        {
          "speaker": "애니",
          "korean": "네, 맞아요. 애니라고 불러 주세요. 안녕하세요?",
          "translation": "對，沒錯。叫我安妮就好。你好！",
          "segments": ["네,\tko:intj:네", "맞아요.\tko:v:맞다+ko:e:아요", "애니라고\tko:prop:애니+ko:p:라고", "불러\tko:v:부르다+ko:e:어", "주세요.\tko:vx:주다+ko:e:세요", "안녕하세요?\tko:adj:안녕하다+ko:e:세요"]
        },
        {
          "speaker": "소라",
          "korean": "반갑습니다, 애니 씨. 저는 한국어 선생님 소라예요. 비가 많이 와요.",
          "translation": "很高興認識你，安妮。我是韓語老師素拉。雨下得好大。",
          "segments": ["반갑습니다,\tko:adj:반갑다+ko:e:습니다", "애니\tko:prop:애니", "씨.\tko:count:씨", "저는\tko:pron:저+ko:p:는", "한국어\tko:n:한국어", "선생님\tko:n:선생+ko:affix:-님", "소라예요.\tko:prop:소라+ko:cop:이다+ko:e:에요", "비가\tko:n:비+ko:p:가", "많이\tko:adv:많이", "와요.\tko:v:오다+ko:e:아요"]
        },
        {
          "speaker": "애니",
          "korean": "네, 비가 와요. 오늘 잘 부탁드려요!",
          "translation": "對啊，下雨了。今天請多指教！",
          "segments": ["네,\tko:intj:네", "비가\tko:n:비+ko:p:가", "와요.\tko:v:오다+ko:e:아요", "오늘\tko:n:오늘", "잘\tko:adv:잘", "부탁드려요!\tko:v:부탁드리다+ko:e:어요"]
        }
      ]
    },
    {
      "id": "D2",
      "title": "D2",
      "location": "未拆分",
      "context": "週二晚間，教室裡的第一堂課",
      "purpose": "輪流做完整自我介紹（名字、國家、職業）。",
      "turns": [
        {
          "speaker": "소라",
          "korean": "여러분, 환영해요. 저는 한국어 선생님 소라예요. 한국 사람이에요. 유키 씨 먼저 인사해요.",
          "translation": "歡迎大家。我是韓語老師素拉，是韓國人。由紀先打招呼吧。",
          "segments": ["여러분,\tko:pron:여러분", "환영해요.\tko:n:환영+ko:v:하다+ko:e:어요", "저는\tko:pron:저+ko:p:는", "한국어\tko:n:한국어", "선생님\tko:n:선생+ko:affix:-님", "소라예요.\tko:prop:소라+ko:cop:이다+ko:e:에요", "한국\tko:prop:한국", "사람이에요.\tko:n:사람+ko:cop:이다+ko:e:에요", "유키\tko:prop:유키", "씨\tko:count:씨", "먼저\tko:adv:먼저", "인사해요.\tko:n:인사+ko:v:하다+ko:e:어요"]
        },
        {
          "speaker": "유키",
          "korean": "네. 안녕하세요? 저는 유키예요. 일본 사람이에요. 병원 간호사예요.",
          "translation": "好。大家好，我是由紀，是日本人，在醫院當護理師。",
          "segments": ["네.\tko:intj:네", "안녕하세요?\tko:adj:안녕하다+ko:e:세요", "저는\tko:pron:저+ko:p:는", "유키예요.\tko:prop:유키+ko:cop:이다+ko:e:에요", "일본\tko:prop:일본", "사람이에요.\tko:n:사람+ko:cop:이다+ko:e:에요", "병원\tko:n:병원", "간호사예요.\tko:n:간호사+ko:cop:이다+ko:e:에요"]
        },
        {
          "speaker": "소라",
          "korean": "반갑습니다, 유키 씨. 애니 씨는요?",
          "translation": "很高興認識你，由紀。安妮呢？",
          "segments": ["반갑습니다,\tko:adj:반갑다+ko:e:습니다", "유키\tko:prop:유키", "씨.\tko:count:씨", "애니\tko:prop:애니", "씨는요?\tko:count:씨+ko:p:는+ko:p:요"]
        },
        {
          "speaker": "애니",
          "korean": "안녕하세요? 제 이름은 애니예요. 대만 사람이에요. 저는 회사원이에요.",
          "translation": "大家好，我的名字是安妮，是台灣人，我是上班族。",
          "segments": ["안녕하세요?\tko:adj:안녕하다+ko:e:세요", "제\tko:pron:저+ko:p:의", "이름은\tko:n:이름+ko:p:은", "애니예요.\tko:prop:애니+ko:cop:이다+ko:e:에요", "대만\tko:prop:대만", "사람이에요.\tko:n:사람+ko:cop:이다+ko:e:에요", "저는\tko:pron:저+ko:p:는", "회사원이에요.\tko:n:회사원+ko:cop:이다+ko:e:에요"]
        }
      ]
    },
    {
      "id": "D3",
      "title": "D3",
      "location": "未拆分",
      "context": "下課後，地鐵站出口",
      "purpose": "애니回想剛才認識的人，向유키核對，유키更正。",
      "turns": [
        {
          "speaker": "애니",
          "korean": "오늘 수업 재미있었어요, 유키 씨.",
          "translation": "由紀，今天的課很有趣。",
          "segments": ["오늘\tko:n:오늘", "수업\tko:n:수업", "재미있었어요,\tko:adj:재미있다+ko:e:었+ko:e:어요", "유키\tko:prop:유키", "씨.\tko:count:씨"]
        },
        {
          "speaker": "유키",
          "korean": "네, 저도요.",
          "translation": "對啊，我也覺得。",
          "segments": ["네,\tko:intj:네", "저도요.\tko:pron:저+ko:p:도+ko:p:요"]
        },
        {
          "speaker": "애니",
          "korean": "그런데... 유키 씨는 회사원이에요?",
          "translation": "不過……由紀是上班族嗎？",
          "segments": ["그런데...\tko:adv:그런데", "유키\tko:prop:유키", "씨는\tko:count:씨+ko:p:는", "회사원이에요?\tko:n:회사원+ko:cop:이다+ko:e:에요"]
        },
        {
          "speaker": "유키",
          "korean": "아니요, 저는 간호사예요.",
          "translation": "不是，我是護理師。",
          "segments": ["아니요,\tko:intj:아니요", "저는\tko:pron:저+ko:p:는", "간호사예요.\tko:n:간호사+ko:cop:이다+ko:e:에요"]
        },
        {
          "speaker": "애니",
          "korean": "아, 맞아요! 유키 씨는 간호사예요. 제가 깜빡했어요.",
          "translation": "啊，對耶！由紀是護理師。我一時忘了。",
          "segments": ["아,\tko:intj:아", "맞아요!\tko:v:맞다+ko:e:아요", "유키\tko:prop:유키", "씨는\tko:count:씨+ko:p:는", "간호사예요.\tko:n:간호사+ko:cop:이다+ko:e:에요", "제가\tko:pron:저+ko:p:가", "깜빡했어요.\tko:v:깜빡하다+ko:e:였+ko:e:어요"]
        },
        {
          "speaker": "유키",
          "korean": "괜찮아요. 다음 주에 봐요!",
          "translation": "沒關係，下週見！",
          "segments": ["괜찮아요.\tko:adj:괜찮다+ko:e:아요", "다음\tko:n:다음", "주에\tko:n:주+ko:p:에", "봐요!\tko:v:보다+ko:e:아요"]
        },
        {
          "speaker": "애니",
          "korean": "네, 다음 주에 봐요!",
          "translation": "好，下週見！",
          "segments": ["네,\tko:intj:네", "다음\tko:n:다음", "주에\tko:n:주+ko:p:에", "봐요!\tko:v:보다+ko:e:아요"]
        }
      ]
    }
  ],
