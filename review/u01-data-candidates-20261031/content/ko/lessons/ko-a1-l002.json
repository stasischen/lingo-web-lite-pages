.c4","text":"저는","correct":true},{"id":"l002.ex02.c5","text":"저은","correct":false,"misconception":"ko.g.topic.aboutness#c01"},{"id":"l002.ex02.c6","text":"저","correct":false,"misconception":"ko.g.topic.aboutness#c01"}]},{"block_id":"l002.ex03","block_type":"exercise","type":"cloze","knowledge":["ko.g.topic.aboutness#c01"],"sentence_id":"ex.ko.s.ko-a1-l002.000030","answer":"서니는","choices":[{"id":"l002.ex03.c4","text":"서니은","correct":false,"misconception":"ko.g.topic.aboutness#c01"},{"id":"l002.ex03.c5","text":"서니","correct":false,"misconception":"ko.g.topic.aboutness#c01"},{"id":"l002.ex03.c6","text":"서니는","correct":true}]},{"block_id":"l002.ex04","block_type":"exercise","type":"cloze","knowledge":["ko.g.topic.aboutness#c01"],"sentence_id":"ex.ko.s.ko-a1-l002.000025","answer":"직업은","choices":[{"id":"l002.ex04.c4","text":"직업","correct":false,"misconception":"ko.g.topic.aboutness#c01"},{"id":"l002.ex04.c5","text":"직업은","correct":true},{"id":"l002.ex04.c6","text":"직업는","correct":false,"misconception":"ko.g.topic.aboutness#c01"}]},{"block_id":"l002.ex05","block_type":"exercise","type":"cloze","knowledge":["ko.g.topic.aboutness#c01"],"sentence_id":"ex.ko.s.ko-a1-l002.000031","answer":"별명은","choices":[{"id":"l002.ex05.c4","text":"별명은","correct":true},{"id":"l002.ex05.c5","text":"별명는","correct":false,"misconception":"ko.g.topic.aboutness#c01"},{"id":"l002.ex05.c6","text":"별명","correct":false,"misconception":"ko.g.topic.aboutness#c01"}]},{"block_id":"l002.ex06","block_type":"exercise","type":"cloze","knowledge":["ko.g.address.social-choice#c01"],"sentence_id":"ex.ko.s.ko-a1-l002.000006","answer":"저는","choices":[{"id":"l002.ex06.c4","text":"이름은","correct":false,"misconception":"ko.g.address.social-choice#c01"},{"id":"l002.ex06.c2","text":"저는","correct":true},{"id":"l002.ex06.c5","text":"직업은","correct":false,"misconception":"ko.g.address.social-choice#c01"}]},{"block_id":"l002.ex07","block_type":"exercise","type":"chunk_assembly","knowledge":["ko.g.address.social-choice#c01"],"sentence_id":"ex.ko.s.ko-a1-l002.000026","answer":["저는","지훈이에요."],"choices":[{"id":"l002.ex07.c3","text":"저는","correct":true},{"id":"l002.ex07.c4","text":"지훈이에요.","correct":true},{"id":"l002.ex07.c5","text":"이름은","correct":false,"misconception":"ko.g.address.social-choice#c01"},{"id":"l002.ex07.c6","text":"직업은","correct":false,"misconception":"ko.g.address.social-choice#c01"}]},{"block_id":"l002.ex08","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.topic.aboutness#c01"],"sentence_id":"ex.ko.s.ko-a1-l002.000027","answer":"저는 서연이에요.","choices":[{"id":"l002.ex08.c4","text":"저는 서연이에요.","correct":true},{"id":"l002.ex08.c5","text":"저은 서연이에요.","correct":false,"misconception":"ko.g.topic.aboutness#c01"},{"id":"l002.ex08.c6","text":"저 서연이에요.","correct":false,"misconception":"ko.g.topic.aboutness#c01"}]},{"block_id":"l002.ex09","block_type":"exercise","type":"chunk_assembly","knowledge":["ko.g.topic.aboutness#c01"],"sentence_id":"ex.ko.s.ko-a1-l002.000028","answer":["저는","회사원이에요."],"choices":[{"id":"l002.ex09.c5","text":"저는","correct":true},{"id":"l002.ex09.c6","text":"회사원이에요.","correct":true},{"id":"l002.ex09.c7","text":"저은","correct":false,"misconception":"ko.g.topic.aboutness#c01"},{"id":"l002.ex09.c8","text":"저","correct":false,"misconception":"ko.g.topic.aboutness#c01"}]},{"block_id":"l002.ex10","block_type":"exercise","type":"chunk_assembly","knowledge":["ko.g.topic.aboutness#c01"],"sentence_id":"ex.ko.s.ko-a1-l002.000021","answer":["서연","씨는","학생이에요."],"choices":[{"id":"l002.ex10.c5","text":"서연","correct":true},{"id":"l002.ex10.c6","text":"씨는","correct":true},{"id":"l002.ex10.c7","text":"학생이에요.","correct":true},{"id":"l002.ex10.c8","text":"씨은","correct":false,"misconception":"ko.g.topic.aboutness#c01"},{"id":"l002.ex10.c9","text":"씨","correct":false,"misconception":"ko.g.topic.aboutness#c01"}]}],"localization":{"jihun":{"name":"Jihun","introduction":"參加語言交流聚會的成人上班族，和 Seoyeon 初次見面。"},"seoyeon":{"name":"Seoyeon","introduction":"第一次參加這個語言交流聚會的成人學生，暱稱是 Seoni。"},"l002.s1":{"description":"在語言交流聚會上，兩位成人同輩 Jihun 和 Seoyeon 初次見面，互相介紹姓名與身分。Seoyeon 第一次參加這個聚會，她的姓名牌上寫著「서니」（Seoni）；Jihun 看到後，向她確認這個暱稱。兩人使用日常禮貌體（해요體）交談。這課先練習介紹、確認姓名與暱稱；主動請別人使用特定稱呼，留待之後學習。"},"l002.tc1":{"title":"清楚說出接下來要聊誰","body":"想把話題聚焦在某個人或事物時，可以在詞後面加上 은 或 는。前面的詞最後一個字有收尾子音（받침）時接 은，沒有時接 는，再用「名詞＋이에요／예요」說明姓名或身分。"},"l002.tc2":{"title":"禮貌地介紹自己","body":"第一次和同輩見面時，韓語習慣用日常禮貌體（해요體），自稱「我」時用禮貌自稱 저。自我介紹姓名或身分時，很適合直接用 저는 開頭。"},"l002.tc5":{"title":"說出別人的職業","body":"想說某個人做什麼工作時，在職業名稱後面加上 이에요 或 예요，例如下方的護理師、廚師、醫師。"},"l002.tc6":{"title":"聊聊身分、職業與暱稱","body":"聚會聊天時，常會聊到職業、學生身分或彼此的暱稱。例如 학생 是學生、직업 是職業、회사원 是上班族、별명 是暱稱、이름표 則是姓名牌。Seoyeon 的姓名牌上寫著 서니（Seoni），那是她的暱稱。"},"l002.ex01":{"prompt":"把給定的 이름 接上本課的 은 或 는，選出完整接法填入空格：「＿＿ 지훈이에요.」。這次練習要保留 은 或 는，後文不變。","feedback_correct":"이름 最後的 름 有收尾子音，接 은 成為 이름은，符合這題指定的接法。"},"l002.ex01.c4":{"explanation":"이름 最後的 름 有收尾子音，這題應接 은；이름는 用了 는，不符合接法。"},"l002.ex01.c6":{"explanation":"口語有時可省略助詞，但這題明確要求 이름 接上 은 或 는；只選 이름 就漏接了。"},"l002.ex02":{"prompt":"把給定的 저 接上本課的 은 或 는，選出完整接法填入空格：「＿＿ 학생이에요.」。這次練習要保留 은 或 는，後文不變。","feedback_correct":"저 沒有收尾子音，接 는 成為 저는；後面的 학생이에요. 保持不變。"},"l002.ex02.c5":{"explanation":"저 沒有收尾子音，這題應接 는；저은 用了 은，不符合接法。"},"l002.ex02.c6":{"explanation":"口語有時可省略助詞，但這題指定把 저 接上 은 或 는；只選 저 沒有完成這次的接法練習。"},"l002.ex03":{"prompt":"把給定的 서니 接上本課的 은 或 는，選出完整接法填入空格：「＿＿ 별명이에요.」。這次練習要保留 은 或 는，後文不變。","feedback_correct":"서니 最後的 니 沒有收尾子音，接 는 成為 서니는。Seoni 是 Seoyeon 的暱稱。"},"l002.ex03.c4":{"explanation":"서니 最後的 니 沒有收尾子音，這題應接 는；서니은 用了 은，不符合接法。"},"l002.ex03.c5":{"explanation":"口語有時可省略助詞，但這題要求 서니 後接 은 或 는；只選 서니 就漏接了。"},"l002.ex04":{"prompt":"把給定的 직업 接上本課的 은 或 는，選出完整接法填入空格：「＿＿ 회사원이에요.」。這次練習要保留 은 或 는，後文不變。","feedback_correct":"직업 最後的 업 有收尾子音，接 은 成為 직업은；後面的 회사원이에요. 保持不變。"},"l002.ex04.c4":{"explanation":"口語有時可省略助詞，但這題要求 직업 後接 은 或 는；只選 직업 就漏接了。"},"l002.ex04.c6":{"explanation":"직업 最後的 업 有收尾子音，這題應接 은；직업는 用了 는，不符合接法。"},"l002.ex05":{"prompt":"把給定的 별명 接上本課的 은 或 는，選出完整接法填入空格：「＿＿ 서니예요.」。這次練習要保留 은 或 는，後文不變。","feedback_correct":"별명 最後的 명 有收尾子音，接 은 成為 별명은；後面的 서니예요. 保持不變。"},"l002.ex05.c5":{"explanation":"별명 最後的 명 有收尾子音，這題應接 은；별명는 用了 는，不符合接法。"},"l002.ex05.c6":{"explanation":"口語有時可省略助詞，但這題要求 별명 後接 은 或 는；只選 별명 就漏接了。"},"l002.ex06":{"prompt":"你要向初次見面的同輩介紹自己是學生。請用本課的禮貌自稱，必須明說「我」，不能省略，選詞填入：「＿＿ 학생이에요.」。後文不變。","feedback_correct":"저 是本課教的禮貌自稱「我」；填入 저는，就能明說「我是學生」，完成這題的自我介紹。"},"l002.ex06.c4":{"explanation":"이름은 指「名字」，接法本身正確，在合適的命名情境也可使用。但這題要求用禮貌自稱明說「我」，它沒有表達指定的自稱。"},"l002.ex06.c5":{"explanation":"직업은 학생이에요 可以用來回答職業問題。但這題要求你用禮貌自稱明說「我」；직업은 談的是職業，沒有使用指定的自稱。"},"l002.ex07":{"prompt":"請選兩個詞塊，把「我是 Jihun」組成一句韓文。必須用本課的禮貌自稱明說「我」，不能省略或改談名字、職業。句尾 지훈이에요. 已給定；每塊只用一次，另有兩個多餘詞塊不用。","feedback_correct":"저는 使用本課的禮貌自稱，明說「我」，再接給定的 지훈이에요.，符合指定的中文「我是 Jihun」。"},"l002.ex07.c5":{"explanation":"이름은 지훈이에요 本身自然，也可用於自我介紹。但這題指定以禮貌自稱明說「我」；選 이름은 會改成「名字是 Jihun」，省去了指定的自稱。"},"l002.ex07.c6":{"explanation":"직업은 的接法本身正確，但指的是「職業」。這題指定的中文是「我」，要求使用本課的禮貌自稱；這個詞塊沒有完成指定的表達。"},"l002.ex08":{"prompt":"給定 저 和 서연이에요.，請把 저 接上本課的 은 或 는，選出接法正確的一句。這次練習要保留 은 或 는，給定的詞與句尾不變。","feedback_correct":"저 沒有收尾子音，接 는 成為 저는，再接給定的 서연이에요.。"},"l002.ex08.c5":{"explanation":"저 沒有收尾子音，這題應接 는；저은 用了 은，不符合接法。句尾不用改。"},"l002.ex08.c6":{"explanation":"口語自我介紹有時可省略助詞，但這題明確要求 저 接上 은 或 는；這個選項漏接，沒有完成指定形式。"},"l002.ex09":{"prompt":"給定 저、회사원이에요.，請把 저 接上本課的 은 或 는，再選兩個詞塊組句。這次練習要保留 은 或 는，句尾不變；每塊只用一次，另有兩個多餘詞塊不用。","feedback_correct":"저 沒有收尾子音，接 는 成為 저는，再接給定的 회사원이에요.，用兩塊完成句子。"},"l002.ex09.c7":{"explanation":"저 沒有收尾子音，這題應接 는；저은 用了 은，不符合接法。회사원이에요. 不用改。"},"l002.ex09.c8":{"explanation":"口語有時可省略助詞，但這題要求 저 接上 은 或 는；只選 저 沒有完成指定的接法。"},"l002.ex10":{"prompt":"依序組合給定的 서연、씨、학생이에요.，把 씨 接上本課的 은 或 는，選三個詞塊組句。這次練習要保留 은 或 는；姓名和 씨 各用一塊，句尾不變，每塊只用一次，另有兩個多餘詞塊不用。","feedback_correct":"은／는 接在 씨 後面；씨 沒有收尾子音，接 는 成為 씨는。姓名 서연、씨는、句尾各用一塊。"},"l002.ex10.c8":{"explanation":"這題的 은／는 接在 씨 後面。씨 沒有收尾子音，應接 는；씨은 用了 은，不符合接法，不是看 서연 的收尾子音。"},"l002.ex10.c9":{"explanation":"口語有時可省略助詞，但這題明確要求 씨 接上 은 或 는；只選 씨 就漏接了。姓名和學生身分都沒有改變。"},"ko:prop:지훈":{"name":"Jihun"},"ko:prop:서연":{"name":"Seoyeon"},"ko:prop:서니":{"name":"Seoni"}},"sentences":{"ex.ko.s.ko-a1-l002.000001":{"id":"ex.ko.s.ko-a1-l002.000001","surface":"안녕하세요. 이 모임은 처음이에요?","atoms":[{"id":"ko:adj:안녕하다+ko:e:시+ko:e:어요","text":"안녕하세요","pos":"adj+e+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:시":"linked","ko:e:어요":"linked"}}},{"id":"ko:det:이","text":"이","pos":"det","dictionary_link":{"status":"linked","part_status":{"ko:det:이":"linked"}}},{"id":"ko:n:모임+ko:p:은","text":"모임은","pos":"n+p","dictionary_link":{"status":"linked","part_status":{"ko:n:모임":"linked","ko:p:은":"linked"}}},{"id":"ko:n:처음+ko:cop:이다+ko:e:에요","text":"처음이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:처음":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"你好。你是第一次參加這個聚會嗎？"},"ex.ko.s.ko-a1-l002.000002":{"id":"ex.ko.s.ko-a1-l002.000002","surface":"네, 처음이에요. 저는 서연이에요. 이름은 뭐예요?","atoms":[{"id":"ko:intj:네","text":"네","pos":"intj","dictionary_link":{"status":"linked","part_status":{"ko:intj:네":"linked"}}},{"id":"ko:n:처음+ko:cop:이다+ko:e:에요","text":"처음이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:처음":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:서연+ko:cop:이다+ko:e:에요","text":"서연이에요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:서연":"named_entity","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:n:이름+ko:p:은","text":"이름은","pos":"n+p","dictionary_link":{"status":"linked","part_status":{"ko:n:이름":"linked","ko:p:은":"linked"}}},{"id":"ko:pron:뭐+ko:cop:이다+ko:e:에요","text":"뭐예요","pos":"pron+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:pron:뭐":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"對，是第一次。我是 Seoyeon。你叫什麼名字？"},"ex.ko.s.ko-a1-l002.000003":{"id":"ex.ko.s.ko-a1-l002.000003","surface":"반가워요, 서연 씨. 저는 지훈이에요.","atoms":[{"id":"ko:adj:반갑다+ko:e:어요","text":"반가워요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:반갑다":"linked","ko:e:어요":"linked"}}},{"id":"ko:prop:서연","text":"서연","pos":"prop","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:서연":"named_entity"}}},{"id":"ko:count:씨","text":"씨","pos":"count","dictionary_link":{"status":"linked","part_status":{"ko:count:씨":"linked"}}},{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:지훈+ko:cop:이다+ko:e:에요","text":"지훈이에요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:지훈":"named_entity","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"很高興認識你，Seoyeon。我是 Jihun。"},"ex.ko.s.ko-a1-l002.000004":{"id":"ex.ko.s.ko-a1-l002.000004","surface":"지훈 씨, 직업은 뭐예요?","atoms":[{"id":"ko:prop:지훈","text":"지훈","pos":"prop","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:지훈":"named_entity"}}},{"id":"ko:count:씨","text":"씨","pos":"count","dictionary_link":{"status":"linked","part_status":{"ko:count:씨":"linked"}}},{"id":"ko:n:직업+ko:p:은","text":"직업은","pos":"n+p","dictionary_link":{"status":"linked","part_status":{"ko:n:직업":"linked","ko:p:은":"linked"}}},{"id":"ko:pron:뭐+ko:cop:이다+ko:e:에요","text":"뭐예요","pos":"pron+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:pron:뭐":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"Jihun，你的職業是什麼？"},"ex.ko.s.ko-a1-l002.000005":{"id":"ex.ko.s.ko-a1-l002.000005","surface":"저는 회사원이에요. 서연 씨는요?","atoms":[{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:n:회사원+ko:cop:이다+ko:e:에요","text":"회사원이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:회사원":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:prop:서연","text":"서연","pos":"prop","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko: