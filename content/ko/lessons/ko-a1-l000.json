  "localization": {
    "sora": {
      "name": "韓素拉",
      "introduction": "首爾麻浦區多文化中心的老師。"
    },
    "annie": {
      "name": "安妮",
      "introduction": "台灣人，任職於台灣公司的首爾分公司，到首爾約兩週，個性健忘。"
    },
    "yuki": {
      "name": "佐藤由紀",
      "introduction": "日本大阪人，職業是護士。"
    },
    "scene.d1": {
      "description": "週二晚上 18:55、下雨，素拉在中心大門依名單迎接新生安妮並確認身分。"
    },
    "scene.d2": {
      "description": "第一堂課教室，素拉帶領由紀和安妮自我介紹。"
    },
    "scene.d3": {
      "description": "下課後地鐵站出口，安妮忘了由紀的職業，問由紀是不是老師，由紀更正自己是護士。"
    },
