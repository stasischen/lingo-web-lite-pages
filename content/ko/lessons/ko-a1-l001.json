{"id":"ko-a1-l001","level":1,"language":"ko","supportLanguage":"zh_tw","revision":"2","status":"ai_reviewed","sourceId":"src.ko.lesson.a1-l001","sceneId":"scene.1","blocks":[{"block_id":"scene.1","block_type":"scene","speakers":["yuna","minsu"]},{"block_id":"t01","block_type":"turn","speaker":"yuna","sentence_id":"ex.ko.s.ko-a1-l001.000001","knowledge":["ko.g.yo.addressee-politeness","ko.g.ida.identification"]},{"block_id":"t02","block_type":"turn","speaker":"minsu","sentence_id":"ex.ko.s.ko-a1-l001.000002","knowledge":["ko.g.yo.addressee-politeness","ko.g.ida.identification","ko.g.word-order.predicate-final"]},{"block_id":"t03","block_type":"turn","speaker":"yuna","sentence_id":"ex.ko.s.ko-a1-l001.000003","knowledge":["ko.g.ida.identification","ko.g.word-order.predicate-final","ko.g.yo.addressee-politeness"]},{"block_id":"t04","block_type":"turn","speaker":"minsu","sentence_id":"ex.ko.s.ko-a1-l001.000004","knowledge":["ko.g.yo.addressee-politeness"]},{"block_id":"t05","block_type":"turn","speaker":"yuna","sentence_id":"ex.ko.s.ko-a1-l001.000005","knowledge":["ko.g.yo.addressee-politeness"]},{"block_id":"tc.yo","block_type":"teaching","kind":"register","knowledge":["ko.g.yo.addressee-politeness#c01"],"examples":["ex.ko.s.ko-a1-l001.000011","ex.ko.s.ko-a1-l001.000001"]},{"block_id":"tc.order","block_type":"teaching","kind":"structure","knowledge":["ko.g.word-order.predicate-final#c01"],"examples":["ex.ko.s.ko-a1-l001.000010","ex.ko.s.ko-a1-l001.000002"]},{"block_id":"tc.ida","block_type":"teaching","kind":"structure","knowledge":["ko.g.ida.identification#c01"],"examples":["ex.ko.s.ko-a1-l001.000001","ex.ko.s.ko-a1-l001.000002"]},{"block_id":"tc.eo","block_type":"teaching","kind":"structure","knowledge":["ko.g.eo.statement#c01"],"examples":["ex.ko.s.ko-a1-l001.000013"]},{"block_id":"ex.a2.01","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.yo.addressee-politeness#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000011","answer":"안녕하세요.","choices":[{"id":"ex.a2.01.c1","text":"안녕.","correct":false,"misconception":"ko.g.yo.addressee-politeness#c01"},{"id":"ex.a2.01.c2","text":"안녕하세요.","correct":true},{"id":"ex.a2.01.c3","text":"반가워.","correct":false,"misconception":"ko.g.yo.addressee-politeness#c01"}]},{"block_id":"ex.a2.02","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.yo.addressee-politeness#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000017","answer":"반가워요.","choices":[{"id":"ex.a2.02.c1","text":"반가워.","correct":false,"misconception":"ko.g.yo.addressee-politeness#c01"},{"id":"ex.a2.02.c2","text":"안녕.","correct":false,"misconception":"ko.g.yo.addressee-politeness#c01"},{"id":"ex.a2.02.c3","text":"반가워요.","correct":true}]},{"block_id":"ex.a2.03","block_type":"exercise","type":"chunk_assembly","knowledge":["ko.g.word-order.predicate-final#c01","ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000010","answer":["저는","유나예요"],"choices":[{"id":"ex.a2.03.c1","text":"저는","correct":true},{"id":"ex.a2.03.c2","text":"유나예요","correct":true},{"id":"ex.a2.03.c3","text":"유나에요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a2.03.c4","text":"유나이예요","correct":false,"misconception":"ko.g.ida.identification#c01"}]},{"block_id":"ex.a2.04","block_type":"exercise","type":"chunk_assembly","knowledge":["ko.g.word-order.predicate-final#c01","ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000016","answer":["제 이름은","민수예요"],"choices":[{"id":"ex.a2.04.c3","text":"제 이름은","correct":true},{"id":"ex.a2.04.c1","text":"민수예요","correct":true},{"id":"ex.a2.04.c2","text":"민수에요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a2.04.c4","text":"민수이예요","correct":false,"misconception":"ko.g.ida.identification#c01"}]},{"block_id":"ex.a2.05","block_type":"exercise","type":"cloze","knowledge":["ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000014","answer":"예요","choices":[{"id":"ex.a2.05.c1","text":"에요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a2.05.c2","text":"요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a2.05.c3","text":"예요","correct":true}]},{"block_id":"ex.a2.06","block_type":"exercise","type":"cloze","knowledge":["ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000015","answer":"이에요","choices":[{"id":"ex.a2.06.c1","text":"예요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a2.06.c2","text":"이에요","correct":true},{"id":"ex.a2.06.c3","text":"에요","correct":false,"misconception":"ko.g.ida.identification#c01"}]},{"block_id":"ex.a2.07","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.eo.statement#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000013","answer":"처음 해요.","choices":[{"id":"ex.a2.07.c1","text":"처음 하요.","correct":false,"misconception":"ko.g.eo.statement#c01"},{"id":"ex.a2.07.c2","text":"처음 하어요.","correct":false,"misconception":"ko.g.eo.statement#c01"},{"id":"ex.a2.07.c3","text":"처음 해요.","correct":true}]},{"block_id":"ex.a2.08","block_type":"exercise","type":"cloze","knowledge":["ko.g.eo.statement#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000013","answer":"해요","choices":[{"id":"ex.a2.08.c1","text":"해요","correct":true},{"id":"ex.a2.08.c2","text":"해어요","correct":false,"misconception":"ko.g.eo.statement#c01"},{"id":"ex.a2.08.c3","text":"하아요","correct":false,"misconception":"ko.g.eo.statement#c01"}]},{"block_id":"ex.a2.09","block_type":"exercise","type":"cloze","knowledge":["ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000018","answer":"예요","choices":[{"id":"ex.a2.09.c1","text":"에요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a2.09.c2","text":"이예요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a2.09.c3","text":"예요","correct":true}]},{"block_id":"ex.a2.10","block_type":"exercise","type":"cloze","knowledge":["ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000019","answer":"이에요","choices":[{"id":"ex.a2.10.c1","text":"예요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a2.10.c2","text":"이에요","correct":true},{"id":"ex.a2.10.c3","text":"에요","correct":false,"misconception":"ko.g.ida.identification#c01"}]}],"localization":{"yuna":{"name":"Yuna","introduction":"第一次參加這場語言交換活動的女性，與 Minsu 初次見面。"},"minsu":{"name":"Minsu","introduction":"第一次參加這場語言交換活動的男性，與 Yuna 初次見面。"},"scene.1":{"description":"Yuna 和 Minsu 是互不認識的成人，在語言交換活動現場第一次見面。他們禮貌地打招呼、介紹姓名，並回應對方的問候。"},"tc.yo":{"title":"用禮貌的態度跟人打招呼","body":"句尾的「요」用來表達對聽者的禮貌。這是日常禮貌體（해요體），像是「안녕하세요」「여기 처음이에요」。初次見面常用的問候與自介，可以直接整句記起來。"},"tc.order":{"title":"清楚介紹自己的名字","body":"想要介紹自己時，先說「저는（我）」或「제 이름은（我的名字）」，再接姓名。說明「是誰」的部分放在句末，自我介紹的常用詞組可以直接整塊記下來。"},"tc.ida":{"title":"用名詞說「是……」","body":"想表達「是……」的時候，可以在名詞後面加上「이에요」或「예요」。名詞最後一個字有收尾子音（받침），如「처음」，接「이에요」；沒有收尾子音，如「민수」，接「예요」。"},"tc.eo":{"title":"禮貌表達第一次做這件事","body":"在雙方都清楚眼前要做什麼活動時，可以用「처음 해요」表示「這是我第一次做這個活動」。「해요」用來禮貌地說自己做的動作。"},"ex.a2.01":{"prompt":"你在語言交換活動第一次見到一位不認識的成人，雙方還沒開始交談，也沒有約定改用隨便的說法。你要用日常禮貌體主動打招呼，該說哪一句？","feedback_correct":"「안녕하세요」是本課學過的禮貌問候，適合向第一次見面的陌生成人打招呼。"},"ex.a2.01.c1":{"explanation":"「안녕」是熟朋友或對晚輩常用的隨便問候，本身是自然的說法。這裡是第一次見面的陌生成人，沒有約定改用隨便的語氣，要選禮貌的「안녕하세요」。"},"ex.a2.01.c3":{"explanation":"「반가워」用隨便的語氣表達見到對方很高興，熟人間可以自然使用。這裡對方是尚不熟識、沒有約定使用隨便語氣的成人，應選禮貌的「안녕하세요」。"},"ex.a2.02":{"prompt":"你和一位第一次見面的陌生成人剛互相介紹姓名，沒有約定改用隨便的說法。你想用日常禮貌體回應「很高興認識你」，該說哪一句？","feedback_correct":"「반가워요」用禮貌的語氣表達很高興認識對方，適合這次初見的回應。"},"ex.a2.02.c1":{"explanation":"「반가워」能表達高興，熟人間可以自然使用，但語氣隨便。這裡對方是初次見面的陌生成人，沒有約定改用隨便的語氣，應用「반가워요」。"},"ex.a2.02.c2":{"explanation":"「안녕」是熟人間自然的隨便招呼；這裡要禮貌地回應「很高興認識你」，也沒有約定改用隨便的語氣，所以應選「반가워요」。"},"ex.a2.03":{"prompt":"Yuna 向第一次見面的成人介紹自己。請選兩個完整詞組，依本課先說「我」、再說姓名的順序，排出日常禮貌體的「我是 Yuna」。","feedback_correct":"先放「저는」，再接「유나예요」，就能說「我是 Yuna」。這題練習先說「我」、再說姓名的完整自介順序；「저는」整塊使用，不需要拆解。"},"ex.a2.03.c3":{"explanation":"人名「유나」後，本課的標準名詞述語寫成「유나예요」。「유나에요」把「예」寫成「에」，是形式寫錯，換位置也不能完成本題。選對詞組後，依題目要求放在「저는」後面。"},"ex.a2.03.c4":{"explanation":"「유나」後接本課學過的「예요」，成為「유나예요」；「유나이예요」多寫了「이」，不是給定姓名的標準形式。先選對詞形，再依本題「我、姓名」的順序排列。"},"ex.a2.04":{"prompt":"Minsu 向第一次見面的成人介紹自己。請選兩個完整詞組，依本課先說「我的名字」、再說姓名的順序，排出日常禮貌體的「我的名字是 Minsu」。","feedback_correct":"先放完整詞組「제 이름은」，再接「민수예요」，就能說「我的名字是 Minsu」。這題依本課先說「我的名字」、再說姓名的順序排列。"},"ex.a2.04.c2":{"explanation":"「민수」後，本課的名詞述語寫成「민수예요」；「민수에요」是形式寫錯，換位置也不能完成本題。選對完整詞組後，再依題目要求放在「제 이름은」後面。"},"ex.a2.04.c4":{"explanation":"「민수」後接「예요」，成為「민수예요」；「민수이예요」多寫了「이」，不是給定姓名的標準形式。先選對詞形，再依本題「我的名字、姓名」的順序排列。"},"ex.a2.05":{"prompt":"Minsu 初次見面介紹自己。請依本課的「名詞＋이에요／예요」補出完整名詞述語，不用簡短回答：「민수＿＿.」","feedback_correct":"「민수」最後的「수」沒有받침，本課用「예요」接成「민수예요」。"},"ex.a2.05.c1":{"explanation":"「민수」後接本課的「예요」，寫成「민수예요」；填「에요」會變成「민수에요」，不是這個名詞述語的標準寫法。這裡是姓名後的拼寫問題，其他結構中的「에요」要依各自用法判斷。"},"ex.a2.05.c2":{"explanation":"「민수요」在簡短回答中可以自然使用；本題要求完整的「名詞＋이에요／예요」陳述，不用簡短回答，因此要填「예요」，成為「민수예요」。"},"ex.a2.06":{"prompt":"Yuna 要用完整的名詞述語陳述「是第一次」。依本課的「名詞＋이에요／예요」補完：「처음＿＿.」","feedback_correct":"「처음」最後的「음」有받침，接「이에요」，成為「처음이에요」。"},"ex.a2.06.c1":{"explanation":"「처음」有받침，要接「이에요」，成為「처음이에요」；填「예요」會變成不合本題標準形式的「처음예요」。「예요」可用在本課的無받침姓名後，這裡不能直接套用。"},"ex.a2.06.c3":{"explanation":"本題要用完整名詞述語說「是第一次」，應寫「처음이에요」；填「에요」會漏掉「이」。其他句子中的「처음에요」可能屬於不同結構，不能用來完成本題要求的陳述。"},"ex.a2.07":{"prompt":"你和一位剛認識的成人正要開始眼前這項語言交換活動。雙方已經知道是在說眼前要做的活動；你要禮貌地說「這是我第一次做這個活動」。哪一句可以這樣說？","feedback_correct":"「처음 해요」在這裡是「這是我第一次做這個活動」。雙方已知道是哪個活動，所以不用再把活動名稱說出來。"},"ex.a2.07.c1":{"explanation":"要說第一次做眼前這個活動，本課學過的說法是「처음 해요」；這裡的動作用「해요」，「하요」不是本題日常禮貌體陳述的標準形式。"},"ex.a2.07.c2":{"explanation":"這裡要用本課已學的「해요」，說「처음 해요」，表示第一次做眼前這個活動；「하어요」不是這裡動詞陳述的標準形式。"},"ex.a2.08":{"prompt":"你正和一位剛認識的成人準備做眼前這項語言交換活動。雙方都知道你說的是眼前的活動。你要禮貌地說「這是我第一次做」，請補完：「처음 ＿＿.」","feedback_correct":"填「해요」，就能用本課學過的「처음 해요」表達第一次做眼前這個活動。"},"ex.a2.08.c2":{"explanation":"「해요」已是這裡要用的完整說法；不要在「해」後再多加「어」寫成「해어요」。填「해요」才能完成本課學過的「처음 해요」。"},"ex.a2.08.c3":{"explanation":"本課用「처음 해요」表達第一次做眼前的活動，這裡應填「해요」；「하아요」不是這裡動詞陳述的標準形式。"},"ex.a2.09":{"prompt":"練習情境中的另一位成人叫 Jisu（지수）。Jisu 初次見面，要用本課的完整「名詞＋이에요／예요」句子介紹自己，不用簡短回答。請補完：「지수＿＿.」","feedback_correct":"「지수」最後的「수」沒有받침，接本課學過的「예요」，成為「지수예요」。"},"ex.a2.09.c1":{"explanation":"這裡接在人名「지수」後的形式是「예요」；「지수에요」把「예」寫成了「에」，不是這個名詞述語的標準寫法。"},"ex.a2.09.c2":{"explanation":"「지수」後接本課的「예요」就可以；「지수이예요」多寫了「이」，不是給定姓名的標準形式。"},"ex.a2.10":{"prompt":"練習情境中的另一位成人叫 Jiwon（지원）。Jiwon 初次見面，要用本課的完整「名詞＋이에요／예요」句子介紹自己，不用簡短回答。請補完：「지원＿＿.」","feedback_correct":"「지원」最後的「원」有받침 ㄴ，接「이에요」，成為「지원이에요」。"},"ex.a2.10.c1":{"explanation":"「지원」有받침，要接「이에요」；「지원예요」少了應有的「이」，不是給定姓名的標準形式。這裡不能套用無받침姓名「지수」的結尾。"},"ex.a2.10.c3":{"explanation":"本題要求的完整名詞述語是「지원이에요」；只填「에요」會漏掉「이」，變成「지원에요」。這裡要完成姓名陳述，其他結構中的「에요」要依各自用法判斷。"},"ko:prop:유나":{"name":"Yuna"},"ko:prop:민수":{"name":"Minsu"},"ko:prop:지수":{"name":"Jisu"},"ko:prop:지원":{"name":"Jiwon"}},"sentences":{"ex.ko.s.ko-a1-l001.000001":{"id":"ex.ko.s.ko-a1-l001.000001","surface":"안녕하세요. 여기 처음이에요.","atoms":[{"id":"ko:adj:안녕하다+ko:e:시+ko:e:어요","text":"안녕하세요","pos":"adj+e+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:시":"linked","ko:e:어요":"linked"}}},{"id":"ko:pron:여기","text":"여기","pos":"pron","dictionary_link":{"status":"linked","part_status":{"ko:pron:여기":"linked"}}},{"id":"ko:n:처음+ko:cop:이다+ko:e:에요","text":"처음이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:처음":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"你好。我是第一次來這裡。"},"ex.ko.s.ko-a1-l001.000002":{"id":"ex.ko.s.ko-a1-l001.000002","surface":"안녕하세요. 저는 민수예요.","atoms":[{"id":"ko:adj:안녕하다+ko:e:시+ko:e:어요","text":"안녕하세요","pos":"adj+e+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:시":"linked","ko:e:어요":"linked"}}},{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:민수+ko:cop:이다+ko:e:에요","text":"민수예요","pos":"prop+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:prop:민수":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"你好。我是 Minsu。"},"ex.ko.s.ko-a1-l001.000003":{"id":"ex.ko.s.ko-a1-l001.000003","surface":"제 이름은 유나예요. 반가워요.","atoms":[{"id":"ko:pron:제","text":"제","pos":"pron","dictionary_link":{"status":"linked","part_status":{"ko:pron:제":"linked"}}},{"id":"ko:n:이름+ko:p:은","text":"이름은","pos":"n+p","dictionary_link":{"status":"linked","part_status":{"ko:n:이름":"linked","ko:p:은":"linked"}}},{"id":"ko:prop:유나+ko:cop:이다+ko:e:에요","text":"유나예요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:유나":"named_entity","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:adj:반갑다+ko:e:어요","text":"반가워요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:반갑다":"linked","ko:e:어요":"linked"}}}],"translation":"我的名字是 Yuna。很高興認識你。"},"ex.ko.s.ko-a1-l001.000004":{"id":"ex.ko.s.ko-a1-l001.000004","surface":"유나 씨, 반가워요.","atoms":[{"id":"ko:prop:유나","text":"유나","pos":"prop","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:유나":"named_entity"}}},{"id":"ko:count:씨","text":"씨","pos":"count","dictionary_link":{"status":"linked","part_status":{"ko:count:씨":"linked"}}},{"id":"ko:adj:반갑다+ko:e:어요","text":"반가워요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:반갑다":"linked","ko:e:어요":"linked"}}}],"translation":"Yuna，很高興認識你。"},"ex.ko.s.ko-a1-l001.000005":{"id":"ex.ko.s.ko-a1-l001.000005","surface":"네, 민수 씨. 잘 부탁해요.","atoms":[{"id":"ko:intj:네","text":"네","pos":"intj","dictionary_link":{"status":"linked","part_status":{"ko:intj:네":"linked"}}},{"id":"ko:prop:민수","text":"민수","pos":"prop","dictionary_link":{"status":"linked","part_status":{"ko:prop:민수":"linked"}}},{"id":"ko:count:씨","text":"씨","pos":"count","dictionary_link":{"status":"linked","part_status":{"ko:count:씨":"linked"}}},{"id":"ko:adv:잘","text":"잘","pos":"adv","dictionary_link":{"status":"linked","part_status":{"ko:adv:잘":"linked"}}},{"id":"ko:v:부탁하다+ko:e:여요","text":"부탁해요","pos":"v+e","dictionary_link":{"status":"linked","part_status":{"ko:v:부탁하다":"linked","ko:e:여요":"linked"}}}],"translation":"好的，Minsu。請多指教。"},"ex.ko.s.ko-a1-l001.000010":{"id":"ex.ko.s.ko-a1-l001.000010","surface":"저는 유나예요.","atoms":[{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:유나+ko:cop:이다+ko:e:에요","text":"유나예요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:유나":"named_entity","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"我是 Yuna。"},"ex.ko.s.ko-a1-l001.000011":{"id":"ex.ko.s.ko-a1-l001.000011","surface":"안녕하세요.","atoms":[{"id":"ko:adj:안녕하다+ko:e:시+ko:e:어요","text":"안녕하세요","pos":"adj+e+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:시":"linked","ko:e:어요":"linked"}}}],"translation":"你好。"},"ex.ko.s.ko-a1-l001.000013":{"id":"ex.ko.s.ko-a1-l001.000013","surface":"처음 해요.","atoms":[{"id":"ko:n:처음","text":"처음","pos":"n","dictionary_link":{"status":"linked","part_status":{"ko:n:처음":"linked"}}},{"id":"ko:v:하다+ko:e:여요","text":"해요","pos":"v+e","dictionary_link":{"status":"linked","part_status":{"ko:v:하다":"linked","ko:e:여요":"linked"}}}],"translation":"這是我第一次做這個活動。"},"ex.ko.s.ko-a1-l001.000014":{"id":"ex.ko.s.ko-a1-l001.000014","surface":"민수예요.","atoms":[{"id":"ko:prop:민수+ko:cop:이다+ko:e:에요","text":"민수예요","pos":"prop+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:prop:민수":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"我是 Minsu。"},"ex.ko.s.ko-a1-l001.000015":{"id":"ex.ko.s.ko-a1-l001.000015","surface":"처음이에요.","atoms":[{"id":"ko:n:처음+ko:cop:이다+ko:e:에요","text":"처음이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:처음":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"是第一次。"},"ex.ko.s.ko-a1-l001.000016":{"id":"ex.ko.s.ko-a1-l001.000016","surface":"제 이름은 민수예요.","atoms":[{"id":"ko:pron:제","text":"제","pos":"pron","dictionary_link":{"status":"linked","part_status":{"ko:pron:제":"linked"}}},{"id":"ko:n:이름+ko:p:은","text":"이름은","pos":"n+p","dictionary_link":{"status":"linked","part_status":{"ko:n:이름":"linked","ko:p:은":"linked"}}},{"id":"ko:prop:민수+ko:cop:이다+ko:e:에요","text":"민수예요","pos":"prop+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:prop:민수":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"我的名字是 Minsu。"},"ex.ko.s.ko-a1-l001.000017":{"id":"ex.ko.s.ko-a1-l001.000017","surface":"반가워요.","atoms":[{"id":"ko:adj:반갑다+ko:e:어요","text":"반가워요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:반갑다":"linked","ko:e:어요":"linked"}}}],"translation":"很高興認識你。"},"ex.ko.s.ko-a1-l001.000018":{"id":"ex.ko.s.ko-a1-l001.000018","surface":"지수예요.","atoms":[{"id":"ko:prop:지수+ko:cop:이다+ko:e:에요","text":"지수예요","pos":"prop+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:prop:지수":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"我是 Jisu。"},"ex.ko.s.ko-a1-l001.000019":{"id":"ex.ko.s.ko-a1-l001.000019","surface":"지원이에요.","atoms":[{"id":"ko:prop:지원+ko:cop:이다+ko:e:에요","text":"지원이에요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:지원":"named_entity","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"我是 Jiwon。"}},"source":{"repo":"https://github.com/stasischen/content-ko.git","branch":"main","head":"e1f1dd1482bca220e4100d2a061735eb504023f7","files":[{"path":"content_v2/review/lessons/ko-a1-l001/core/lesson.json","sha256":"66525d227ec3f53b1538833b9281a9cd47f302968c6bb27d704875da77ea0034"},{"path":"content_v2/review/lessons/ko-a1-l001/core/sentences.json","sha256":"96cd949ca8910bace8914286676cb7752a98da9236c3668d4222c1aec526282c"},{"path":"content_v2/review/lessons/ko-a1-l001/i18n/zh_tw/lesson.json","sha256":"fe054d2f953ed933d55b6a75453a494f5cdc77edb53893912a8281a4f942f048"},{"path":"content_v2/review/lessons/ko-a1-l001/i18n/zh_tw/sentences.json","sha256":"83ca5847a851407c2cac7f55cb737b5fbc85aac8700c29434a5a5a7ceca50592"}]}}
