.1":{"description":"週二傍晚，麻浦多文化中心門口。韓素拉老師拿著名單迎接第一次來上課的新生陳怡君。"},"scene.2":{"description":"週二 19:02，麻浦多文化中心 302 教室，第一堂課開始。韓素拉老師示範介紹名字與職業；佐藤由紀介紹名字與日本國籍。老師接著請陳怡君自我介紹，怡君說明姓名、臺灣國籍與上班族身分，再問由紀；由紀回答自己是護理師，兩人互道很高興認識對方。"},"article.2":{"title":"我們班的同學","intro":"多文化中心公布欄上的同學介紹卡。"},"ko:prop:대만":{"name":"臺灣"},"ko:prop:독일":{"name":"德國"},"ko:prop:루카스":{"name":"盧卡斯"},"ko:prop:마이클":{"name":"麥可"},"ko:prop:사토":{"name":"佐藤"},"ko:prop:유키":{"name":"由紀"},"ko:prop:일본":{"name":"日本"},"ko:prop:천이쥔":{"name":"陳怡君"},"ko:prop:캐나다":{"name":"加拿大"},"ko:prop:타나왓":{"name":"塔納瓦"},"ko:prop:태국":{"name":"泰國"},"ko:prop:한소라":{"name":"韓素拉"}},"sentences":{"ex.ko.s.ko-a1-l001.000001":{"id":"ex.ko.s.ko-a1-l001.000001","surface":"안녕하세요.","atoms":[{"id":"ko:adj:안녕하다+ko:e:세요","text":"안녕하세요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:세요":"linked"}}}],"translation":"您好。"},"ex.ko.s.ko-a1-l001.000002":{"id":"ex.ko.s.ko-a1-l001.000002","surface":"천이쥔 씨예요?","atoms":[{"id":"ko:prop:천이쥔","text":"천이쥔","pos":"prop","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:천이쥔":"named_entity"}}},{"id":"ko:count:씨+ko:cop:이다+ko:e:에요","text":"씨예요","pos":"count+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:count:씨":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"是陳怡君嗎？"},"ex.ko.s.ko-a1-l001.000008":{"id":"ex.ko.s.ko-a1-l001.000008","surface":"제 이름은 사토 유키예요.","atoms":[{"id":"ko:pron:제","text":"제","pos":"pron","dictionary_link":{"status":"linked","part_status":{"ko:pron:제":"linked"}}},{"id":"ko:n:이름+ko:p:은","text":"이름은","pos":"n+p","dictionary_link":{"status":"linked","part_status":{"ko:n:이름":"linked","ko:p:은":"linked"}}},{"id":"ko:prop:사토","text":"사토","pos":"prop","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:사토":"named_entity"}}},{"id":"ko:prop:유키+ko:cop:이다+ko:e:에요","text":"유키예요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:유키":"named_entity","k