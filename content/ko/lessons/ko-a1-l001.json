,{"block_id":"ex.a3.01","block_type":"exercise","type":"cloze","knowledge":["ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000014","answer":"이에요","choices":[{"id":"ex.a3.01.c1","text":"예요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a3.01.c2","text":"이에요","correct":true},{"id":"ex.a3.01.c3","text":"이예요","correct":false,"misconception":"ko.g.ida.identification#c01"}]},{"block_id":"ex.a3.02","block_type":"exercise","type":"cloze","knowledge":["ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000009","answer":"예요","choices":[{"id":"ex.a3.02.c1","text":"에요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a3.02.c2","text":"이예요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a3.02.c3","text":"예요","correct":true}]},{"block_id":"ex.a3.03","block_type":"exercise","type":"cloze","knowledge":["ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000018","answer":"이에요","choices":[{"id":"ex.a3.03.c1","text":"이에요","correct":true},{"id":"ex.a3.03.c2","text":"에요","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a3.03.c3","text":"예요","correct":false,"misconception":"ko.g.ida.identification#c01"}]},{"block_id":"ex.a3.04","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.yo.addressee-politeness#c01","ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000017","answer":"저는 박도현이에요.","choices":[{"id":"ex.a3.04.c1","text":"저는 박도현예요.","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a3.04.c2","text":"저는 박도현이에요.","correct":true},{"id":"ex.a3.04.c3","text":"저는 박도현이야.","correct":false,"misconception":"ko.g.yo.addressee-politeness#c01"}]},{"block_id":"ex.a3.05","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000004","answer":"네, 저는 천이쥔이에요.","choices":[{"id":"ex.a3.05.c1","text":"네, 선생님이에요.","correct":false,"misconception":"ko:n:선생님#s1"},{"id":"ex.a3.05.c2","text":"네, 저는 천이쥔이에요.","correct":true},{"id":"ex.a3.05.c3","text":"처음이에요.","correct":false,"misconception":"ko:n:처음#s1"}]},{"block_id":"ex.a3.06","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.ida.identification#c01"],"sentence_id":"ex.ko.s.ko-a1-l001.000013","answer":"저 사람, 선생님이에요?","choices":[{"id":"ex.a3.06.c1","text":"저 사람, 선생님이에요?","correct":true},{"id":"ex.a3.06.c2","text":"네, 선생님이에요.","correct":false,"misconception":"ko.g.ida.identification#c01"},{"id":"ex.a3.06.c3","text":"저는 유키예요.","correct":false,"misconception":"ko:pron:저#s1"}]},{"block_id":"ex.a3.07","block_type":"exercise","type":"multiple_choice","knowledge":["ko:v:인사하다#s1"],"sentence_id":"ex.ko.s.ko-a1-l001.000008","answer":"우리 인사해요.","choices":[{"id":"ex.a3.07.c1","text":"우리 인사해요.","correct":true},{"id":"ex.a3.07.c2","text":"안녕하세요.","correct":false,"misconception":"ko:adj:안녕하다#s1"},{"id":"ex.a3.07.c3","text":"반가워요.","correct":false,"misconception":"ko:adj:반갑다#s1"}]},{"block_id":"ex.a3.08","block_type":"exercise","type":"multiple_choice","knowledge":["ko:n:선생님#s1"],"sentence_id":"ex.ko.s.ko-a1-l001.000023","answer":"선생님이에요.","choices":[{"id":"ex.a3.08.c1","text":"선생님이에요.","correct":true},{"id":"ex.a3.08.c2","text":"저는 한소라예요.","correct":false,"misconception":"ko:pron:저#s1"},{"id":"ex.a3.08.c3","text":"반가워요.","correct":false,"misconception":"ko:adj:반갑다#s1"}]},{"block_id":"ex.a3.09","block_type":"exercise","type":"multiple_choice","knowledge":["ko:n:처음#s1"],"sentence_id":"ex.ko.s.ko-a1-l001.000027","answer":"처음이에요.","choices":[{"id":"ex.a3.09.c1","text":"처음이에요.","correct":true},{"id":"ex.a3.09.c2","text":"제 이름은 천이쥔이에요.","correct":false,"misconception":"ko:n:이름#s1"},{"id":"ex.a3.09.c3","text":"반가워요.","correct":false,"misconception":"ko:adj:반갑다#s1"}]}],"localization":{"sora":{"name":"Han Sora","introduction":"麻浦多文化中心晚間班的韓語老師。"},"ijwin":{"name":"Cheon Ijwin","introduction":"來自台灣的成人學生，第一次上麻浦多文化中心晚間韓語課。"},"yuki":{"name":"Sato Yuki","introduction":"麻浦多文化中心晚間班的成人學生，坐在 Cheon Ijwin 旁邊。"},"dohyeon":{"name":"Park Dohyeon","introduction":"住在同棟大樓三樓的鄰居，第一次在信箱前和 Cheon Ijwin 見面。"},"ko:prop:천이쥔":{"name":"Cheon Ijwin"},"ko:prop:한소라":{"name":"Han Sora"},"ko:prop:사토":{"name":"Sato"},"ko:prop:유키":{"name":"Yuki"},"ko:prop:박도현":{"name":"Park Dohyeon"},"scene.1":{"description":"週二傍晚下雨時，Han Sora 在中心大門口拿名單迎接新生，與 Cheon Ijwin 確認姓名並互相問候。"},"scene.2":{"description":"第一堂課開始時，Han Sora 邀請大家互相問候。Cheon Ijwin 與 Sato Yuki 互相介紹後，小聲詢問那位正在帶課的人是不是老師，由 Sato Yuki 回答。"},"scene.3":{"description":"晚上九點，Cheon Ijwin 下課回家，在住宅大樓信箱前遇見住三樓的鄰居 Park Dohyeon；兩人第一次見面，互相問候並報上姓名。"},"article.1":{"title":"中心大廳的名牌卡"},"tc.ida":{"title":"用名詞說「是……」","body":"名詞最後一個字有收尾子音時接「이에요」，如「천이쥔이에요」；沒有收尾子音時接「예요」，如「유키예요」。兩種形式都用來禮貌地介紹身分或姓名。"},"tc.yo":{"title":"初次見面時使用禮貌說法","body":"初次見面的成人之間，使用日常禮貌體（해요體）說話，例如「저는 박도현이에요」。見面時也可以用整句問候語「반가워요」。"},"ex.a3.01":{"prompt":"教室裡，Sato Yuki 聽到一個關於老師身分的問句，要肯定回答。請補完：「네, 선생님＿＿.」","feedback_correct":"「선생님」最後有收尾子音，後面接「이에요」，完整回答是「네, 선생님이에요.」"},"ex.a3.01.c1":{"explanation":"「선생님」有收尾子音，不能把「이에요」縮成「예요」。"},"ex.a3.01.c3":{"explanation":"這裡要寫「이에요」；「이예요」多寫了一個「이」，不是標準的名詞述語形式。"},"ex.a3.02":{"prompt":"第一堂課，Sato Yuki 用簡稱介紹自己。請補完這句禮貌自我介紹：「저는 유키＿＿.」","feedback_correct":"「유키」最後沒有收尾子音，接「예요」成為「유키예요」。"},"ex.a3.02.c1":{"explanation":"名詞述語的縮寫形式是「예요」，不是直接接「에요」。"},"ex.a3.02.c2":{"explanation":"「유키」後可以接縮約形式「예요」，也可保留未縮約形式「이에요」；此處不能把兩種形式混寫成「이예요」。"},"ex.a3.03":{"prompt":"中心大門口，Cheon Ijwin 向初次見面的 Han Sora 介紹自己。請補完整：「저는 천이쥔＿＿.」","feedback_correct":"名字「천이쥔」最後有收尾子音，應接「이에요」。"},"ex.a3.03.c2":{"explanation":"「에요」少了名詞述語所需的「이」，應寫「이에요」。"},"ex.a3.03.c3":{"explanation":"有收尾子音的「천이쥔」後要接「이에요」，不能直接接「예요」。"},"ex.a3.04":{"prompt":"晚上在住宅大樓信箱前，Park Dohyeon 第一次和 Cheon Ijwin 說話，兩人還沒有約定使用隨意的說法。請選一句合適的自我介紹。","feedback_correct":"「저는 박도현이에요」使用了有收尾子音姓名後的正確形式，也符合初次見面時的禮貌程度。"},"ex.a3.04.c1":{"explanation":"「박도현」有收尾子音，後面要接「이에요」，不能寫「박도현예요」。"},"ex.a3.04.c3":{"explanation":"「저는 박도현이야」意思是「我是 Park Dohyeon」，但「이야」是隨意說法，不適合兩位初見成人尚未約定的情境。"},"ex.a3.05":{"prompt":"中心大門口，甲問「천이쥔 씨예요?」。哪一句是乙用來肯定回答並確認自己姓名的原句？","feedback_correct":"「네, 저는 천이쥔이에요」肯定回答了姓名確認問句，指出回答者名叫 Cheon Ijwin。"},"ex.a3.05.c1":{"explanation":"「네, 선생님이에요」回答的是老師身分，不是確認回答者的姓名。"},"ex.a3.05.c3":{"explanation":"「처음이에요」說的是第一次，不是確認回答者的姓名。"},"ex.a3.06":{"prompt":"教室裡，Cheon Ijwin 想向 Sato Yuki 詢問她注意到的人的身分。下列哪句符合 Ijwin 的疑問？","feedback_correct":"Ijwin 問「저 사람, 선생님이에요?」，確認她看到的那個人是不是老師。"},"ex.a3.06.c2":{"explanation":"「네, 선생님이에요」是回答句，不是 Ijwin 問出的疑問句。"},"ex.a3.06.c3":{"explanation":"「저는 유키예요」是自我介紹，不是 Ijwin 問出的疑問句。"},"ex.a3.07":{"prompt":"第一堂課開始時，教師邀請全班開始互相問候。下列哪句表達這項邀請？","feedback_correct":"「우리 인사해요」是邀請大家互相問候；接下來可以彼此打招呼並介紹自己。"},"ex.a3.07.c3":{"explanation":"「반가워요」是見面問候語，沒有表達邀請全班一起互相問候。"},"ex.a3.08":{"prompt":"閱讀中心大廳班級名牌卡。哪一句直接寫出 Han Sora 的老師身分？","feedback_correct":"Han Sora 的卡直接寫著「선생님이에요」，說明她是老師。"},"ex.a3.08.c2":{"explanation":"「저는 한소라예요」只介紹 Han Sora 的姓名，沒有說明 Han Sora 的老師身分。"},"ex.a3.08.c3":{"explanation":"「반가워요」是問候語，沒有說明 Han Sora 的老師身分。"},"ex.a3.09":{"prompt":"閱讀中心大廳班級名牌卡。哪一句寫出 Cheon Ijwin 第一次來上課？","feedback_correct":"Cheon Ijwin 的卡寫著「처음이에요」；依第一堂課情境，這是第一次來上課。"},"ex.a3.09.c2":{"explanation":"「제 이름은 천이쥔이에요」介紹姓名，沒有說明是否第一次來上課。"},"ex.a3.07.c2":{"explanation":"「안녕하세요」是問候語，沒有表達邀請全班一起互相問候。"},"ex.a3.09.c3":{"explanation":"「반가워요」是問候語，沒有說明是否第一次來上課。"}},"sentences":{"ex.ko.s.ko-a1-l001.000001":{"id":"ex.ko.s.ko-a1-l001.000001","surface":"안녕하세요.","atoms":[{"id":"ko:adj:안녕하다+ko:e:시+ko:e:어요","text":"안녕하세요","pos":"adj+e+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:시":"linked","ko:e:어요":"linked"}}}],"translation":"你好。"},"ex.ko.s.ko-a1-l001.000002":{"id":"ex.ko.s.ko-a1-l001.000002","surface":"안녕하세요.","atoms":[{"id":"ko:adj:안녕하다+ko:e:시+ko:e:어요","text":"안녕하세요","pos":"adj+e+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:시":"linked","ko:e:어요":"linked"}}}],"translation":"你好。"},"ex.ko.s.ko-a1-l001.000003":{"id":"ex.ko.s.ko-a1-l001.000003","surface":"천이쥔 씨예요?","atoms":[{"id":"ko:prop:천이쥔","text":"천이쥔","pos":"prop","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:천이쥔":"named_entity"}}},{"id":"ko:n:씨+ko:cop:이다+ko:e:에요","text":"씨예요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:cop:이다":"linked","ko:e:에요":"linked","ko:n:씨":"linked"}}}],"translation":"你是 Cheon Ijwin 嗎？"},"ex.ko.s.ko-a1-l001.000004":{"id":"ex.ko.s.ko-a1-l001.000004","surface":"네, 저는 천이쥔이에요.","atoms":[{"id":"ko:intj:네","text":"네","pos":"intj","dictionary_link":{"status":"linked","part_status":{"ko:intj:네":"linked"}}},{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:천이쥔+ko:cop:이다+ko:e:에요","text":"천이쥔이에요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:천이쥔":"named_entity","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"對，我是 Cheon Ijwin。"},"ex.ko.s.ko-a1-l001.000005":{"id":"ex.ko.s.ko-a1-l001.000005","surface":"반가워요.","atoms":[{"id":"ko:adj:반갑다+ko:e:어요","text":"반가워요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:반갑다":"linked","ko:e:어요":"linked"}}}],"translation":"很高興認識你。"},"ex.ko.s.ko-a1-l001.000006":{"id":"ex.ko.s.ko-a1-l001.000006","surface":"반가워요.","atoms":[{"id":"ko:adj:반갑다+ko:e:어요","text":"반가워요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:반갑다":"linked","ko:e:어요":"linked"}}}],"translation":"我也很高興認識你。"},"ex.ko.s.ko-a1-l001.000007":{"id":"ex.ko.s.ko-a1-l001.000007","surface":"안녕하세요.","atoms":[{"id":"ko:adj:안녕하다+ko:e:시+ko:e:어요","text":"안녕하세요","pos":"adj+e+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:시":"linked","ko:e:어요":"linked"}}}],"translation":"大家好。"},"ex.ko.s.ko-a1-l001.000008":{"id":"ex.ko.s.ko-a1-l001.000008","surface":"우리 인사해요.","atoms":[{"id":"ko:pron:우리","text":"우리","pos":"pron","dictionary_link":{"status":"linked","part_status":{"ko:pron:우리":"linked"}}},{"id":"ko:v:인사하다+ko:e:여요","text":"인사해요","pos":"v+e","dictionary_link":{"status":"linked","part_status":{"ko:v:인사