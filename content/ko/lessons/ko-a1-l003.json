eo.statement#c02"],"examples":["ex.ko.s.ko-a1-l003.000005","ex.ko.s.ko-a1-l003.000006","ex.ko.s.ko-a1-l003.000016","ex.ko.s.ko-a1-l003.000012","ex.ko.s.ko-a1-l003.000019"]},{"block_id":"l003.tc2","block_type":"teaching","kind":"usage","knowledge":["ko.g.ida.identification#c01","ko.g.ida.identification#c02","ko.g.topic.aboutness#c01","ko.g.address.social-choice#c02"],"examples":["ex.ko.s.ko-a1-l003.000003","ex.ko.s.ko-a1-l003.000004","ex.ko.s.ko-a1-l003.000005"]},{"block_id":"l003.tc3","block_type":"teaching","kind":"meaning","knowledge":["ko.g.ida.identification#c01"],"examples":["ex.ko.s.ko-a1-l003.000013"]},{"block_id":"l003.tc4","block_type":"teaching","kind":"meaning","knowledge":["ko.g.topic.aboutness#c01"],"examples":["ex.ko.s.ko-a1-l003.000014","ex.ko.s.ko-a1-l003.000015"]},{"block_id":"l003.ex01","block_type":"exercise","type":"cloze","knowledge":["ko.g.eo.statement#c02"],"sentence_id":"ex.ko.s.ko-a1-l003.000017","answer":"커요","choices":[{"id":"l003.ex01.c1","text":"커요","correct":true},{"id":"l003.ex01.c2","text":"크요","correct":false,"misconception":"ko.g.eo.statement#c02"},{"id":"l003.ex01.c3","text":"크예요","correct":false,"misconception":"ko.g.eo.statement#c02"}]},{"block_id":"l003.ex02","block_type":"exercise","type":"cloze","knowledge":["ko.g.eo.statement#c02"],"sentence_id":"ex.ko.s.ko-a1-l003.000018","answer":"예뻐요","choices":[{"id":"l003.ex02.c1","text":"예쁘요","correct":false,"misconception":"ko.g.eo.statement#c02"},{"id":"l003.ex02.c2","text":"예뻐요","correct":true},{"id":"l003.ex02.c3","text":"예쁘예요","correct":false,"misconception":"ko.g.eo.statement#c02"}]},{"block_id":"l003.ex03","block_type":"exercise","type":"cloze","knowledge":["ko.g.eo.statement#c02"],"sentence_id":"ex.ko.s.ko-a1-l003.000020","answer":"좋아요","choices":[{"id":"l003.ex03.c1","text":"좋어요","correct":false,"misconception":"ko.g.eo.statement#c02"},{"id":"l003.ex03.c2","text":"좋이에요","correct":false,"misconception":"ko.g.eo.statement#c02"},{"id":"l003.ex03.c3","text":"좋아요","correct":true}]},{"block_id":"l003.ex04","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.eo.statement#c02"],"sentence_id":"ex.ko.s.ko-a1-l003.000021","answer":"미국은 예뻐요.","choices":[{"id":"l003.ex04.c1","text":"미국은 예쁘예요.","correct":false,"misconception":"ko.g.eo.statement#c02"},{"id":"l003.ex04.c2","text":"미국은 예뻐요.","correct":true},{"id":"l003.ex04.c3","text":"미국은 예쁘요.","correct":false,"misconception":"ko.g.eo.statement#c02"}]},{"block_id":"l003.ex05","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.eo.statement#c02"],"sentence_id":"ex.ko.s.ko-a1-l003.000022","answer":"고향은 조용해요.","choices":[{"id":"l003.ex05.c1","text":"고향은 조용해요.","correct":true},{"id":"l003.ex05.c2","text":"고향은 커요.","correct":false,"misconception":"ko:adj:크다#s1"},{"id":"l003.ex05.c3","text":"고향은 예뻐요.","correct":false,"misconception":"ko:adj:예쁘다#s1"}]},{"block_id":"l003.ex06","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.eo.statement#c02"],"sentence_id":"ex.ko.s.ko-a1-l003.000023","answer":"시골은 좋아요.","choices":[{"id":"l003.ex06.c1","text":"시골은 좋이에요.","correct":false,"misconception":"ko.g.eo.statement#c02"},{"id":"l003.ex06.c2","text":"시골은 좋어요.","correct":false,"misconception":"ko.g.eo.statement#c02"},{"id":"l003.ex06.c3","text":"시골은 좋아요.","correct":true}]},{"block_id":"l003.ex07","block_type":"exercise","type":"chunk_assembly","knowledge":["ko.g.eo.statement#c02"],"sentence_id":"ex.ko.s.ko-a1-l003.000024","answer":["중국은","커요."],"choices":[{"id":"l003.ex07.c1","text":"중국은","correct":true},{"id":"l003.ex07.c2","text":"커요.","correct":true},{"id":"l003.ex07.c3","text":"크요.","correct":false,"misconception":"ko.g.eo.statement#c02"},{"id":"l003.ex07.c4","text":"크예요.","correct":false,"misconception":"ko.g.eo.statement#c02"}]},{"block_id":"l003.ex08","block_type":"exercise","type":"chunk_assembly","knowledge":["ko.g.eo.statement#c02"],"sentence_id":"ex.ko.s.ko-a1-l003.000019","answer":["시골은","조용해요."],"choices":[{"id":"l003.ex08.c1","text":"시골은","correct":true},{"id":"l003.ex08.c2","text":"조용해요.","correct":true},{"id":"l003.ex08.c3","text":"조용하요.","correct":false,"misconception":"ko.g.eo.statement#c02"},{"id":"l003.ex08.c4","text":"조용하예요.","correct":false,"misconception":"ko.g.eo.statement#c02"}]}],"localization":{"minjae":{"name":"Minjae","introduction":"家鄉是首爾，覺得首爾很大；在語言交換聚會上認識 Jina。"},"jina":{"name":"Jina","introduction":"來自釜山，覺得釜山很漂亮；第一次參加這場語言交換聚會。"},"l003.s1":{"description":"Minjae 和 Jina 在語言交換聚會上第一次見面。他們互相介紹，詢問彼此來自哪裡，聊聊家鄉的特色，最後道別。"},"l003.tc1":{"title":"用形容詞描述地方","body":"形容詞直接用日常禮貌體（해요體）陳述，不接 이에요／예요。크다→커요、예쁘다→예뻐요：ㅡ 脫落；좋다→좋아요：좋 的母音是 ㅗ，接 -아요；조용하다→조용해요：하다→해요。"},"l003.tc2":{"title":"問對方是哪裡人","body":"地名＋사람 表示來自某地的人。問「어디 사람이에요?」，可答「저는 부산 사람이에요.」。고향 指出生或長大的地方；問「고향은 어디예요?」，可答「고향은 서울이에요.」。"},"l003.tc3":{"title":"用 출신 說來自哪裡","body":"用「地名＋출신」說明來處，地名放在前面。「서울 출신이에요.」就是「來自首爾」，也可說「서울 사람이에요.」。"},"l003.tc4":{"title":"用國名說是哪國人","body":"한국 韓國、미국 美國、일본 日本、중국 中國、캐나다 加拿大。國名後接 사람이에요 可說是哪國人：「저는 한국 사람이에요.」是「我是韓國人」；「캐나다 사람이에요.」是「是加拿大人」。"},"l003.ex01":{"prompt":"看地圖時，你想說「加拿大很大」。請把 크다 改成本課教的日常禮貌體，填入「캐나다는 ＿＿.」。","feedback_correct":"對！크다 的 ㅡ 脫落後用 커요，整句是「캐나다는 커요.」。"},"l003.ex01.c2":{"explanation":"這裡要說加拿大很大，크다 的 ㅡ 要脫落，應用 커요，不能直接用 크요。"},"l003.ex01.c3":{"explanation":"這裡用形容詞 크다 直接說加拿大很大，應用 커요，不能把 크 當名詞接 예요。"},"l003.ex02":{"prompt":"Jina 說釜山很漂亮。請把 예쁘다 改成本課教的日常禮貌體，填入「부산은 ＿＿.」。","feedback_correct":"對！예쁘다 的 ㅡ 脫落後用 예뻐요，整句是「부산은 예뻐요.」。"},"l003.ex02.c1":{"explanation":"這裡要說釜山很漂亮，예쁘다 的 ㅡ 要脫落，應用 예뻐요，不能直接用 예쁘요。"},"l003.ex02.c3":{"explanation":"這裡用形容詞 예쁘다 直接描述釜山，應用 예뻐요，不能把 예쁘 當名詞接 예요。"},"l003.ex03":{"prompt":"朋友介紹首爾時，你覺得首爾是個不錯的地方，想用 좋다 說「首爾很好」。請填入「서울은 ＿＿.」。","feedback_correct":"對！좋다 在這裡接 -아요，說成「서울은 좋아요.」。"},"l003.ex03.c1":{"explanation":"這裡用 좋다 評價首爾，좋 的母音是 ㅗ，應接 -아요，說 좋아요。"},"l003.ex03.c2":{"explanation":"這裡用形容詞 좋다 直接說首爾很好，應用 좋아요，不能把 좋 當名詞接 이에요。"},"l003.ex04":{"prompt":"朋友給你看美國的風景照片，你想用 예쁘다 說「美國很漂亮」。哪一句用了本課教的日常禮貌體？","feedback_correct":"對！예쁘다 在這裡用 예뻐요，說成「미국은 예뻐요.」。"},"l003.ex04.c1":{"explanation":"要稱讚美國風景漂亮，應把 예쁘다 改成 예뻐요，不把 예쁘 當名詞接 예요。"},"l003.ex04.c3":{"explanation":"要稱讚美國風景漂亮，예쁘다 的 ㅡ 要脫落，應說「미국은 예뻐요.」。"},"l003.ex05":{"prompt":"在另一次交流中，朋友說「서울은 커요.」。你的家鄉地方小、很安靜，而且你覺得景色並不漂亮。接著介紹自己的家鄉時，哪一句符合這些資訊？","feedback_correct":"對！「고향은 조용해요.」說家鄉很安靜，符合情境；另外兩句的「大」和「漂亮」都與題目資訊相反。"},"l003.ex05.c2":{"explanation":"這句是「家鄉很大」，但題目明說家鄉地方小，所以不符合情境；要表達已知的安靜特色，用 조용해요。"},"l003.ex05.c3":{"explanation":"這句是「家鄉很漂亮」，但題目明說你覺得景色並不漂亮，所以不符合情境；조용해요 才符合已知資訊。"},"l003.ex06":{"prompt":"談到鄉下時，你覺得鄉下是個不錯的地方，想用 좋다 說「鄉下很好」。哪一句形式正確？","feedback_correct":"對！좋다 用 좋아요 直接作陳述，說成「시골은 좋아요.」。"},"l003.ex06.c1":{"explanation":"這裡用形容詞 좋다 直接評價鄉下，應說「시골은 좋아요.」，不把 좋 當名詞接 이에요。"},"l003.ex06.c2":{"explanation":"這裡用 좋다 說鄉下很好，좋 的母音是 ㅗ，應接 -아요，說 좋아요。"},"l003.ex07":{"prompt":"看地圖時，你想說「中國很大」。請選詞塊組成完整句，將 크다 改成本課教的日常禮貌體。","feedback_correct":"對！「중국은」加上「커요.」，組成「중국은 커요.」。"},"l003.ex07.c3":{"explanation":"接在「중국은」後，要用 크다 描述中國很大，ㅡ 要脫落，應選「커요.」。"},"l003.ex07.c4":{"explanation":"接在「중국은」後，크다 應用 커요 直接作述語，不能把 크 當名詞接 예요。"},"l003.ex08":{"prompt":"你向朋友介紹一處安靜的鄉下，想說「鄉下很安靜」。請選詞塊組成完整句，將 조용하다 改成本課教的日常禮貌體。","feedback_correct":"對！「시골은」加上「조용해요.」，組成「시골은 조용해요.」。"},"l003.ex08.c3":{"explanation":"接在「시골은」後，조용하다 的 하다 在這裡要改成 해요，應選「조용해요.」。"},"l003.ex08.c4":{"explanation":"接在「시골은」後，要直接用形容詞 조용해요 描述安靜，不能把 조용하 當名詞接 예요。"},"ko:prop:민재":{"name":"Minjae"},"ko:prop:지나":{"name":"Jina"},"ko:prop:부산":{"name":"釜山"},"ko:prop:서울":{"name":"首爾"},"ko:prop:미국":{"name":"美國"},"ko:prop:한국":{"name":"韓國"},"ko:prop:캐나다":{"name":"加拿大"},"ko:prop:중국":{"name":"中國"},"ko:prop:일본":{"name":"日本"}},"sentences":{"ex.ko.s.ko-a1-l003.000001":{"id":"ex.ko.s.ko-a1-l003.000001","surface":"안녕하세요. 여기 처음이에요?","atoms":[{"id":"ko:adj:안녕하다+ko:e:시+ko:e:어요","text":"안녕하세요","pos":"adj+e+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:시":"linked","ko:e:어요":"linked"}}},{"id":"ko:pron:여기","text":"여기","pos":"pron","dictionary_link":{"status":"linked","part_status":{"ko:pron:여기":"linked"}}},{"id":"ko:n:처음+ko:cop:이다+ko:e:에요","text":"처음이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:처음":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"你好。你是第一次來這裡嗎？"},"ex.ko.s.ko-a1-l003.000002":{"id":"ex.ko.s.ko-a1-l003.000002","surface":"네, 처음이에요. 저는 지나예요. 반가워요.","atoms":[{"id":"ko:intj:네","text":"네","pos":"intj","dictionary_link":{"status":"linked","part_status":{"ko:intj:네":"linked"}}},{"id":"ko:n:처음+ko:cop:이다+ko:e:에요","text":"처음이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:처음":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:지나+ko:cop:이다+ko:e:에요","text":"지나예요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:지나":"named_entity","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:adj:반갑다+ko:e:어요","text":"반가워요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:반갑다":"linked","ko:e:어요":"linked"}}}],"translation":"是，我是第一次來。我是 Jina，很高興認識你。"},"ex.ko.s.ko-a1-l003.000003":{"id":"ex.ko.s.ko-a1-l003.000003","surface":"반가워요. 저는 민재예요. 어디 사람이에요?","atoms":[{"id":"ko:adj:반갑다+ko:e:어요","text":"반가워요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:반갑다":"linked","ko:e:어요":"linked"}}},{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:민재+ko:cop:이다+ko:e:에요","text":"민재예요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:민재":"named_entity","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:pron:어디","text":"어디","pos":"pron","dictionary_link":{"status":"linked","part_status":{"ko:pron:어디":"linked"}}},{"id":"ko:n:사람+ko:cop:이다+ko:e:에요","text":"사람이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:사람":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"很高興認識你。我是 Minjae。你是哪裡人？"},"ex.ko.s.ko-a1-l003.000004":{"id":"ex.ko.s.ko-a1-l003.000004","surface":"저는 부산 사람이에요. 민재 씨 고향은 어디예요?","atoms":[{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:부산","text":"부산","pos":"prop","dictionary_link":{"status":"linked","part_status":{"ko:prop:부산":"linked"}}},{"id":"ko:n:사람+ko:cop:이다+ko:e:에요","text":"사람이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:사람":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:prop:민재","text":"민재","pos":"prop","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:민재":"named_entity"}}},{"id":"ko:count:씨","text":"씨","pos":"count","dictionary_link":{"status":"linked","part_status":{"ko:count:씨":"linked"}}},{"id":"ko:n:고향+ko:p:은","text":"고향은","pos":"n+p","dictionary_link":{"status":"linked","part_status":{"ko:n:고향":"linked","ko:p:은":"linked"}}},{"id":"ko:pron:어디+ko:cop:이다+ko:e:에요","text":"어디예요","pos":"pron+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:pron:어디":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"我是釜山人。Minjae，請問你的家鄉在哪裡？"},"ex.ko.s.ko-a1-l003.000005":{"id":"ex.ko.s.ko-a1-l003.000005","surface":"고향은 서울이에요. 서울은 커요.","atoms":[{"id":"ko:n:고향+ko:p:은","text":"고향은","pos":"n+p","dictionary_link":{"status":"linked","part_status":{"ko:n:고향":"linked","ko:p:은":"linked"}}},{"id":"ko:prop:서울+ko:cop:이다+ko:e:에요","text":"서울이에요","pos":"prop+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:prop:서울":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:prop:서울+ko:p:은","text":"서울은","pos":"prop+p","dictionary_link":{"status":"linked","part_status":{"ko:prop:서울":"linked","ko:p:은":"linked"}}},{"id":"ko:adj:크다+ko:e:어요","text":"커요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:크다":"linked","ko:e:어요":"linked"}}}],"translation":"我的家鄉是首爾。首爾很大。"},"ex.ko.s.ko-a1-l003.000006":{"id":"ex.ko.s.ko-a1-l003.000006","surface":"아, 부산은 예뻐요.","atoms":[{"