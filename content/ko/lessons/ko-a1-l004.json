},{"block_id":"l004.s1.t11","block_type":"turn","speaker":"minji","sentence_id":"ex.ko.s.ko-a1-l004.000029","knowledge":["ko.g.focus.additive#c01","ko.g.eo.statement#c01"]},{"block_id":"l004.tc1","block_type":"teaching","kind":"usage","knowledge":["ko.g.focus.additive#c01"],"examples":["ex.ko.s.ko-a1-l004.000027","ex.ko.s.ko-a1-l004.000028","ex.ko.s.ko-a1-l004.000029","ex.ko.s.ko-a1-l004.000018","ex.ko.s.ko-a1-l004.000019"]},{"block_id":"l004.tc2","block_type":"teaching","kind":"structure","knowledge":["ko.g.eo.question#c01"],"examples":["ex.ko.s.ko-a1-l004.000007","ex.ko.s.ko-a1-l004.000026","ex.ko.s.ko-a1-l004.000028","ex.ko.s.ko-a1-l004.000012"]},{"block_id":"l004.tc3","block_type":"teaching","kind":"structure","knowledge":["ko.g.case.object#c01"],"examples":["ex.ko.s.ko-a1-l004.000006","ex.ko.s.ko-a1-l004.000012","ex.ko.s.ko-a1-l004.000017","ex.ko.s.ko-a1-l004.000021","ex.ko.s.ko-a1-l004.000022"]},{"block_id":"l004.tc4","block_type":"teaching","kind":"usage","knowledge":["ko.g.topic.aboutness#c01","ko.g.ida.identification#c01"],"examples":["ex.ko.s.ko-a1-l004.000015","ex.ko.s.ko-a1-l004.000016","ex.ko.s.ko-a1-l004.000006"]},{"block_id":"l004.tc5","block_type":"teaching","kind":"meaning","knowledge":["ko:n:외국어#s1","ko:n:언어#s1"],"examples":["ex.ko.s.ko-a1-l004.000018","ex.ko.s.ko-a1-l004.000001"]},{"block_id":"l004.ex1","block_type":"exercise","type":"cloze","knowledge":["ko.g.case.object#c01"],"sentence_id":"ex.ko.s.ko-a1-l004.000025","answer":"일본어를","choices":[{"id":"l004.ex1.a","text":"일본어를","correct":true},{"id":"l004.ex1.b","text":"일본어을","correct":false,"misconception":"ko.g.case.object#c01"},{"id":"l004.ex1.c","text":"일본어는","correct":false,"misconception":"ko.g.case.object#c01"}]},{"block_id":"l004.ex2","block_type":"exercise","type":"cloze","knowledge":["ko.g.case.object#c01"],"sentence_id":"ex.ko.s.ko-a1-l004.000030","answer":"이름을","choices":[{"id":"l004.ex2.a","text":"이름을","correct":true},{"id":"l004.ex2.b","text":"이름를","correct":false,"misconception":"ko.g.case.object#c01"},{"id":"l004.ex2.c","text":"이름은","correct":false,"misconception":"ko.g.case.object#c01"}]},{"block_id":"l004.ex3","block_type":"exercise","type":"cloze","knowledge":["ko.g.case.object#c01"],"sentence_id":"ex.ko.s.ko-a1-l004.000031","answer":"영어를","choices":[{"id":"l004.ex3.a","text":"영어를","correct":true},{"id":"l004.ex3.b","text":"영어을","correct":false,"misconception":"ko.g.case.object#c01"},{"id":"l004.ex3.c","text":"영어는","correct":false,"misconception":"ko.g.case.object#c01"}]},{"block_id":"l004.ex4","block_type":"exercise","type":"cloze","knowledge":["ko.g.focus.additive#c01"],"sentence_id":"ex.ko.s.ko-a1-l004.000032","answer":"고향도","choices":[{"id":"l004.ex4.a","text":"고향도","correct":true},{"id":"l004.ex4.b","text":"고향을도","correct":false,"misconception":"ko.g.focus.additive#c01"},{"id":"l004.ex4.c","text":"도고향","correct":false,"misconception":"ko.g.focus.additive#c01"}]},{"block_id":"l004.ex5","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.focus.additive#c01"],"sentence_id":"ex.ko.s.ko-a1-l004.000033","answer":"영어도 조금 해요.","choices":[{"id":"l004.ex5.a","text":"영어도 조금 해요.","correct":true},{"id":"l004.ex5.b","text":"저도 영어를 조금 해요.","correct":false,"misconception":"ko.g.focus.additive#c01"},{"id":"l004.ex5.c","text":"영어를도 조금 해요.","correct":false,"misconception":"ko.g.focus.additive#c01"}]},{"block_id":"l004.ex6","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.eo.question#c01"],"sentence_id":"ex.ko.s.ko-a1-l004.000034","answer":"아니요, 조금 해요.","choices":[{"id":"l004.ex6.a","text":"아니요, 조금 해요.","correct":true},{"id":"l004.ex6.b","text":"네, 잘해요.","correct":false,"misconception":"ko.g.eo.question#c01"},{"id":"l004.ex6.c","text":"네, 이름을 써요.","correct":false,"misconception":"ko.g.eo.question#c01"}]},{"block_id":"l004.ex7","block_type":"exercise","type":"chunk_assembly","knowledge":["ko.g.case.object#c01"],"sentence_id":"ex.ko.s.ko-a1-l004.000024","answer":["켄은","한국어를","공부해요."],"choices":[{"id":"l004.ex7.a","text":"켄은","correct":true},{"id":"l004.ex7.b","text":"한국어를","correct":true},{"id":"l004.ex7.c","text":"공부해요.","correct":true},{"id":"l004.ex7.d","text":"켄을","correct":false,"misconception":"ko.g.case.object#c01"},{"id":"l004.ex7.e","text":"한국어을","correct":false,"misconception":"ko.g.case.object#c01"}]},{"block_id":"l004.ex8","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.eo.question#c01"],"sentence_id":"ex.ko.s.ko-a1-l004.000028","answer":"고향도 써요?","choices":[{"id":"l004.ex8.a","text":"고향도 써요?","correct":true},{"id":"l004.ex8.b","text":"한국어를 잘해요?","correct":false,"misconception":"ko.g.eo.question#c01"},{"id":"l004.ex8.c","text":"민지 씨는 영어를 해요?","correct":false,"misconception":"ko.g.eo.question#c01"}]},{"block_id":"l004.ex9","block_type":"exercise","type":"multiple_choice","knowledge":["ko.g.eo.question#c01"],"sentence_id":"ex.ko.s.ko-a1-l004.000012","answer":"이름을 써요?","choices":[{"id":"l004.ex9.a","text":"이름을 써요?","correct":true},{"id":"l004.ex9.b","text":"일본어를 공부해요?","correct":false,"misconception":"ko.g.eo.question#c01"},{"id":"l004.ex9.c","text":"영어를 조금 해요?","correct":false,"misconception":"ko.g.eo.question#c01"}]}],"localization":{"minji":{"name":"Minji","introduction":"來自韓國首爾的女性，以韓語為母語，正在學日語，也會一點英語。"},"ken":{"name":"Ken","introduction":"來自美國的男性，以英語為母語，正在學韓語，會說一點韓語。這是他第一次參加這場語言交換活動。"},"l004.s1":{"description":"語言交換活動的第一晚，Minji 和 Ken 在報到處第一次見面，兩人各拿到一張小卡。Minji 手裡拿著小卡，和 Ken 邊聊家鄉、所學語言與會說多少，邊準備填卡。聊完語言，Minji 把注意力轉回小卡，提醒 Ken 填名字，兩人再確認其他欄位。「이름을 써요」是兩人一起填卡時的直接提醒。"},"l004.tc1":{"title":"도：在名詞後加上「也」","body":"도 接在要追加的名詞後。영어도 追加的是英語，고향도 追加的是家鄉欄；這裡用 도 取代 을／를。外語例句延續 Minji 的觀點：先說英語是外語，再補充中文也是。"},"l004.tc2":{"title":"用日常禮貌體詢問","body":"日常禮貌體（해요體）用 -아／어요? 問「…嗎」，說話時配合疑問語調。잘해요 來自 잘하다，表示「很會」，要連寫；對話問韓語程度，小卡問句則確認填寫要求。"},"l004.tc3":{"title":"을／를：標出動作的對象","body":"名詞有收尾子音時接 을，沒有收尾子音時接 를。이름 的 름 有收尾子音 ㅁ，用 이름을；한국어 以母音結尾，用 한국어를。공부를 해요 的 공부 是名詞「學習」。"},"l004.tc4":{"title":"照著欄位填小卡","body":"小卡填姓名、家鄉和正在學的語言。Ken 的範例：이름：켄；고향：미국；언어：한국어。對照下方句子：名字是 Ken，家鄉是美國，正在學韓語。"},"l004.tc5":{"title":"從誰的角度說「外語」？","body":"언어 是「語言」，외국어 是「外語」。Minji 以韓語為母語，英語和中文對她來說都是外語；例句從她的角度說明，沒有表示她會說中文。"},"ko:prop:민지":{"name":"Minji"},"ko:prop:켄":{"name":"Ken"},"ko:prop:미국":{"name":"美國"},"ko:prop:서울":{"name":"首爾"},"l004.ex1":{"prompt":"Minji 在學日語。請用 을／를 完成句子，標出她學的語言：민지는 ＿＿ 공부해요.","feedback_correct":"일본어 以母音結尾，要接 를：민지는 일본어를 공부해요."},"l004.ex1.b":{"explanation":"일본어 最後的 어 沒有收尾子音，要接 를，不能接 을。"},"l004.ex1.c":{"explanation":"일본어는 可用來把日語當話題，但本題指定用 을／를 標出學習對象，應填 일본어를。"},"l004.ex2":{"prompt":"Ken 要在小卡填名字。請用 을／를 完成句子，標出要寫的內容：＿＿ 써요.","feedback_correct":"이름 以收尾子音 ㅁ 結尾，要接 을：이름을 써요."},"l004.ex2.b":{"explanation":"이름 最後的 름 有收尾子音 ㅁ，要接 을，不能接 를。"},"l004.ex2.c":{"explanation":"이름은 可用來談名字這個話題，但本題指定用 을／를 標出要寫的內容，應填 이름을。"},"l004.ex3":{"prompt":"Minji 會一點英語。請用 을／를 完成句子，標出她會說的語言：＿＿ 조금 해요.","feedback_correct":"영어 以母音結尾，要接 를：영어를 조금 해요."},"l004.ex3.b":{"explanation":"영어 最後的 어 沒有收尾子音，要接 를，不能接 을。"},"l004.ex3.c":{"explanation":"영어는 可用來把英語當話題，但本題指定用 을／를 標出會說的語言，應填 영어를。"},"l004.ex4":{"prompt":"小卡已要求填名字，現在補充「家鄉也要填」。完成句子：＿＿ 써요.","feedback_correct":"도 直接接在 고향 後，表示名字之外，家鄉也要填：고향도 써요."},"l004.ex4.b":{"explanation":"本題要說「家鄉也要填」，도 直接接在 고향 後，取代這裡的 을，不寫成 고향을도。"},"l004.ex4.c":{"explanation":"本題的「也」要用接在名詞後的 도，應寫 고향도，不能把 도 放到 고향 前面。"},"l004.ex5":{"prompt":"Minji 已提到自己在學日語。Ken 現在問她會不會說英語；她要強調新增的是「英語這個語言」，回答「英語也會一點」。選出符合這個意思的回答。","feedback_correct":"영어도 把「也」加在英語上，表示日語之外，英語也會一點。"},"l004.ex5.b":{"explanation":"저도 表示「我也」，追加的是說話的人；本題指定追加的是英語這個語言，應用 영어도。"},"l004.ex5.c":{"explanation":"本題的「英語也」用 영어도；도 在這裡取代 를，不能把兩個接成 영어를도。"},"l004.ex6":{"prompt":"Minji 問 Ken「한국어를 잘해요?」。Ken 只會一點韓語，還稱不上很會。他應怎麼回答？","feedback_correct":"問題問的是「很會韓語嗎」，所以先用 아니요 否定「很會」，再用 조금 해요 說明只會一點。"},"l004.ex6.b":{"explanation":"네, 잘해요. 肯定自己很會韓語，與題目說 Ken 只會一點不符。"},"l004.ex6.c":{"explanation":"這句說的是填名字，沒有回答對方問的韓語程度。"},"l004.ex7":{"prompt":"Ken 在學韓語。請依「Ken／韓語／學習」的順序，選三個詞塊組成一句話；每塊只用一次。","feedback_correct":"켄은 한국어를 공부해요.：Ken 是這句談論的人，한국어를 標出他學的語言，最後接 공부해요."},"l004.ex7.d":{"explanation":"켄을 把 Ken 標成動作的對象；本題是 Ken 學韓語，不是把 Ken 當學習對象。"},"l004.ex7.e":{"explanation":"한국어 最後的 어 沒有收尾子音，要用 한국어를，不能用 한국어을。"},"l004.ex8":{"prompt":"Ken 已知道名字要填，現在想確認「家鄉也要填嗎」。Minji 接著回答「네, 고향도 써요. 언어도 써요.」。Ken 剛才應問哪一句？","feedback_correct":"고향도 써요? 問家鄉是否也要填，能接上 Minji 確認家鄉與語言都要填的回答。"},"l004.ex8.b":{"explanation":"這句問的是韓語程度，無法配對本題確認家鄉填寫要求的回答。"},"l004.ex8.c":{"explanation":"這句問 Minji 會不會說英語，沒有詢問小卡的家鄉欄。"},"l004.ex9":{"prompt":"Ken 指著小卡的姓名欄，想確認這欄是否填名字。Minji 回答「네, 이름을 써요.」。選出能配對這個回答、也符合 Ken 想確認的事的問句。","feedback_correct":"이름을 써요? 確認是否填名字，能接上 네, 이름을 써요. 這個回答。"},"l004.ex9.b":{"explanation":"這句問是否學日語，沒有詢問姓名欄的填寫要求。"},"l004.ex9.c":{"explanation":"這句問會不會一點英語，與是否填名字無關。"}},"sentences":{"ex.ko.s.ko-a1-l004.000001":{"id":"ex.ko.s.ko-a1-l004.000001","surface":"안녕하세요. 언어 교환 모임이에요?","atoms":[{"id":"ko:adj:안녕하다+ko:e:시+ko:e:어요","text":"안녕하세요","pos":"adj+e+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:안녕하다":"linked","ko:e:시":"linked","ko:e:어요":"linked"}}},{"id":"ko:n:언어","text":"언어","pos":"n","dictionary_link":{"status":"linked","part_status":{"ko:n:언어":"linked"}}},{"id":"ko:n:교환","text":"교환","pos":"n","dictionary_link":{"status":"linked","part_status":{"ko:n:교환":"linked"}}},{"id":"ko:n:모임+ko:cop:이다+ko:e:에요","text":"모임이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:모임":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"你好。這是語言交換聚會嗎？"},"ex.ko.s.ko-a1-l004.000002":{"id":"ex.ko.s.ko-a1-l004.000002","surface":"네. 처음이에요. 저는 켄이에요.","atoms":[{"id":"ko:intj:네","text":"네","pos":"intj","dictionary_link":{"status":"linked","part_status":{"ko:intj:네":"linked"}}},{"id":"ko:n:처음+ko:cop:이다+ko:e:에요","text":"처음이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:처음":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:켄+ko:cop:이다+ko:e:에요","text":"켄이에요","pos":"prop+cop+e","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:켄":"named_entity","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"是的。我是第一次來。我是 Ken。"},"ex.ko.s.ko-a1-l004.000003":{"id":"ex.ko.s.ko-a1-l004.000003","surface":"반가워요. 저는 민지예요. 켄 씨 고향은 어디예요?","atoms":[{"id":"ko:adj:반갑다+ko:e:어요","text":"반가워요","pos":"adj+e","dictionary_link":{"status":"linked","part_status":{"ko:adj:반갑다":"linked","ko:e:어요":"linked"}}},{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:민지+ko:cop:이다+ko:e:에요","text":"민지예요","pos":"prop+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:prop:민지":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:prop:켄","text":"켄","pos":"prop","dictionary_link":{"status":"linked_with_exemptions","part_status":{"ko:prop:켄":"named_entity"}}},{"id":"ko:count:씨","text":"씨","pos":"count","dictionary_link":{"status":"linked","part_status":{"ko:count:씨":"linked"}}},{"id":"ko:n:고향+ko:p:은","text":"고향은","pos":"n+p","dictionary_link":{"status":"linked","part_status":{"ko:n:고향":"linked","ko:p:은":"linked"}}},{"id":"ko:pron:어디+ko:cop:이다+ko:e:에요","text":"어디예요","pos":"pron+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:pron:어디":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}}],"translation":"很高興認識你。我是 Minji。Ken，你的家鄉在哪裡？"},"ex.ko.s.ko-a1-l004.000004":{"id":"ex.ko.s.ko-a1-l004.000004","surface":"미국이에요. 저는 미국 사람이에요.","atoms":[{"id":"ko:prop:미국+ko:cop:이다+ko:e:에요","text":"미국이에요","pos":"prop+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:prop:미국":"linked","ko:cop:이다":"linked","ko:e:에요":"linked"}}},{"id":"ko:pron:저+ko:p:는","text":"저는","pos":"pron+p","dictionary_link":{"status":"linked","part_status":{"ko:pron:저":"linked","ko:p:는":"linked"}}},{"id":"ko:prop:미국","text":"미국","pos":"prop","dictionary_link":{"status":"linked","part_status":{"ko:prop:미국":"linked"}}},{"id":"ko:n:사람+ko:cop:이다+ko:e:에요","text":"사람이에요","pos":"n+cop+e","dictionary_link":{"status":"linked","part_status":{"ko:n:사람":"l