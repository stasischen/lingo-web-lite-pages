  "dialogue": [
    {
      "id": "D1",
      "title": "D1 · 多文化中心櫃檯",
      "location": "多文化中心櫃檯",
      "context": "週四上課前，缺席第一課的初次到課學員前來櫃檯報到",
      "purpose": "소라 協助 마이클 確認身分、完成姓名與職業登記並發放名牌。",
      "turns": [
        {
          "speaker": "소라",
          "korean": "안녕하세요? 이름은 뭐예요?",
          "translation": "您好？請問名字是什麼？"
        },
        {
          "speaker": "마이클",
          "korean": "안녕하세요? 제 이름은 마이클 브라운이에요. 오늘 처음이에요.",
          "translation": "您好？我的名字是麥可·布朗。今天第一次來。"
        },
        {
          "speaker": "소라",
          "korean": "마이클 씨, 직업은요?",
          "translation": "麥可先生，請問職業呢？"
        },
        {
          "speaker": "마이클",
          "korean": "저는 학생이에요. 저분, 선생님이에요?",
          "translation": "我是學生。那位是老師嗎？"
        },
        {
          "speaker": "소라",
          "korean": "아니요, 센터 직원이에요. 저는 한국어 선생님 소라예요.",
          "translation": "不是，是中心職員。我是韓文老師索拉。"
        },
        {
          "speaker": "마이클",
          "korean": "네, 반갑습니다.",
          "translation": "好的，很高興認識您。"
        },
        {
          "speaker": "소라",
          "korean": "이름표예요.",
          "translation": "這是名牌。"
        }
      ]
    },
    {
      "id": "D2",
      "title": "D2 · 中心旁咖啡館",
      "location": "中心旁咖啡館",
      "context": "下課後，三位同班學員一起喝咖啡聊天",
      "purpose": "使用目標整句「애니라고 불러요（請叫我 Annie）」說明希望別人怎麼稱呼自己。",
      "turns": [
        {
          "speaker": "애니",
          "korean": "제 이름은 천이쥔이에요. 제 별명은 애니예요. 애니라고 불러요.",
          "translation": "我的名字是陳怡君。我的綽號是 Annie。請叫我 Annie。"
        },
        {
          "speaker": "마이클",
          "korean": "네, 애니 씨.",
          "translation": "好的，Annie。"
        }
      ]
    },
    {
      "id": "D3",
      "title": "D3 · 中心外長椅",
      "location": "中心外長椅",
      "context": "課間休息時間，三人坐在長椅上吹風聊天",
      "purpose": "互相詢問彼此的嗜好並自然接話。",
      "turns": [
        {
          "speaker": "애니",
          "korean": "마이클 씨, 취미는 뭐예요?",
          "translation": "麥可，請問你的嗜好是什麼？"
        },
        {
          "speaker": "마이클",
          "korean": "제 취미는 영화예요. 애니 씨는요?",
          "translation": "我的嗜好是電影。Annie 呢？"
        },
        {
          "speaker": "애니",
          "korean": "음악이에요. 유키 씨는요?",
          "translation": "是音樂。Yuki 呢？"
        },
        {
          "speaker": "유키",
          "korean": "제 취미는 여행이에요.",
          "translation": "我的嗜好是旅行。"
        },
        {
          "speaker": "애니",
          "korean": "그래요?",
          "translation": "是嗎？"
        }
      ]
    }
  ],
  "article": {
    "title": "短文",
    "rows": [
      {
        "korean": "오늘 밥집 메뉴예요.",
        "translation": "今天飯館的菜單。"
      },
      {
        "korean": "오늘 점심은 비빔밥이에요.",
        "translation": "今天午餐是拌飯。"
      },
      {
        "korean": "김밥, 라면은 점심 메뉴예요.",
        "translation": "飯捲、拉麵是午餐供應的品項。"
      },
      {
        "korean": "오늘 저녁은 불고기, 김치찌개예요.",
        "translation": "今天晚餐是烤肉、泡菜鍋。"
      },
      {
        "korean": "물은 서비스예요.",
        "translation": "水是免費提供。"
      },
      {
        "korean": "라면은 저녁 서비스예요.",
        "translation": "拉麵是晚餐免費贈送。"
      },
      {
        "korean": "요리사 박도현",
        "translation": "廚師 朴道賢"
      }
    ]
  },
  "notes": [
    {
