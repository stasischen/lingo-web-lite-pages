  "dialogue": [
    {
      "id": "D1",
      "title": "D1 · 地鐵站務室",
      "location": "地鐵站務室",
      "context": "下班後，애니來到地鐵站務室認領自己忘在車上的包包。站務員查看收到的三個包包，發現其中只有一個是書包，向애니展示並交回。",
      "purpose": "애니向站務員呼喚並表明要認領包包；站務員說明有三個包包並詢問是什麼包包；애니說明是書包以明確辨認物品；站務員查看確認三個包中只有一個是書包，展示並交回該書包；애니道謝，完成認領核對。",
      "turns": [
        {
          "speaker": "애니",
          "korean": "저기요, 제 가방이에요.",
          "translation": "不好意思，那是我的包包。"
        },
        {
          "speaker": "역무원",
          "korean": "가방 세 개 있어요.",
          "translation": "這裡有三個包包。"
        },
        {
          "speaker": "역무원",
          "korean": "무슨 가방이에요?",
          "translation": "請問是什麼包包？"
        },
        {
          "speaker": "애니",
          "korean": "책가방이에요.",
          "translation": "是書包。"
        },
        {
          "speaker": "역무원",
          "korean": "여기 있어요.",
          "translation": "在這裡，給您。"
        },
        {
          "speaker": "애니",
          "korean": "감사합니다.",
          "translation": "謝謝。"
        }
      ]
    },
    {
      "id": "D2",
      "title": "D2 · 教室",
      "location": "教室",
      "context": "上課前，소라老師與學生마이클在教室準備。소라老師看見마이클桌上的辭典，也展示自己使用的辭典，兩人互相查看並比較彼此使用的辭典。",
      "purpose": "維持師生互動關係；소라老師看見마이클的辭典並詢問是什麼辭典；마이클說明自己使用韓語辭典學韓語；소라老師展示自己的辭典並說明自己使用英語辭典；마이클詢問老師是否在學英語，소라老師確認回答，讓比較彼此使用的辭典真正在情境中發生。",
      "turns": [
        {
          "speaker": "소라",
          "korean": "마이클 씨, 무슨 사전이에요?",
          "translation": "마이클，請問是什麼辭典？"
        },
        {
          "speaker": "마이클",
          "korean": "한국어 사전이에요.",
          "translation": "是韓語辭典。"
        },
        {
          "speaker": "마이클",
          "korean": "한국어를 공부해요.",
          "translation": "我學習韓語。"
        },
        {
          "speaker": "소라",
          "korean": "저는 영어 사전을 사용해요.",
          "translation": "我使用英語辭典。"
        },
        {
          "speaker": "마이클",
          "korean": "영어를 공부해요?",
          "translation": "您在學習英語嗎？"
        },
        {
          "speaker": "소라",
          "korean": "네, 영어를 공부해요.",
          "translation": "是的，我學習英語。"
        }
      ]
    },
    {
      "id": "D3",
      "title": "D3 · 公寓大樓門口",
      "location": "公寓大樓門口",
      "context": "晚上，애니在大樓門口遇到已熟識的鄰居도현。도현手上拿著書，애니好奇詢問。",
      "purpose": "熟識鄰居見面問候；애니注意到도현手上的書並詢問是什麼書；도현說明是中文書，簡潔完成日常交流。",
      "turns": [
        {
          "speaker": "애니",
          "korean": "도현 씨, 안녕하세요.",
          "translation": "도현，你好。"
        },
        {
          "speaker": "도현",
          "korean": "네, 애니 씨, 안녕하세요.",
          "translation": "你好，애니。"
        },
        {
          "speaker": "애니",
          "korean": "무슨 책이에요?",
          "translation": "請問是什麼書？"
        },
        {
          "speaker": "도현",
          "korean": "중국어 책이에요.",
          "translation": "是中文書。"
        }
      ]
    }
  ],
  "article": {
    "title": "분실물 안내",
    "rows": [
      {
        "korean": "분실물의 색은 검은색, 흰색, 빨간색, 파란색, 노란색이에요.",
        "translation": "遺失物的顏色是黑色、白色、紅色、藍色、黃色。"
      },
      {
        "korean": "검은색 우산은 두 개예요.",
        "translation": "黑色雨傘有兩把。"
      },
      {
        "korean": "흰색 휴대폰은 한 개예요.",
        "translation": "白色手機有一支。"
      },
      {
        "korean": "빨간색 지갑은 한 개예요.",
        "translation": "紅色錢包有一個。"
      },
      {
        "korean": "파란색 휴대폰은 두 개예요.",
        "translation": "藍色手機有兩支。"
      },
      {
        "korean": "노란색 열쇠는 세 개예요.",
        "translation": "黃色鑰匙有三把。"
      },
      {
        "korean": "다른 물건도 있어요.",
        "translation": "也有其他物品。"
      }
    ]
  },
