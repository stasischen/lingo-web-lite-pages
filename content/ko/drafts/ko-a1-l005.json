  "dialogue": [
    {
      "id": "D1",
      "title": "D1 · 社區公園長椅",
      "location": "社區公園長椅",
      "context": "週日下午，마이클 為了소라老師的作業在公園替애니錄製介紹影片。開拍前兩人先核對姓名、稱呼與介紹項目；隨後正式開拍，마이클 依序介紹애니的各項背景，最後在鏡頭前詢問家人人數",
      "purpose": "開拍前確認受訪者姓名與介紹重點；開拍後依序向鏡頭介紹姓名、別名、職業、國家與語言；最後完成家庭人數問答。",
      "turns": [
        {
          "speaker": "마이클",
          "korean": "잠깐만요. 이름은 뭐예요?",
          "translation": "等一下。請問名字是什麼？"
        },
        {
          "speaker": "애니",
          "korean": "천이쥔이에요. 제 별명은 애니예요.",
          "translation": "是陳怡君。我的別名是 Annie。"
        },
        {
          "speaker": "마이클",
          "korean": "직업, 나라, 언어를 소개해요?",
          "translation": "要介紹職業、國家和語言嗎？"
        },
        {
          "speaker": "애니",
          "korean": "네, 좋아요.",
          "translation": "好啊。"
        },
        {
          "speaker": "마이클",
          "korean": "안녕하세요. 이 친구는 천이쥔 씨예요.",
          "translation": "大家好。這位朋友是陳怡君小姐。"
        },
        {
          "speaker": "마이클",
          "korean": "별명은 애니예요.",
          "translation": "別名是 Annie。"
        },
        {
          "speaker": "마이클",
          "korean": "애니 씨는 회사원이에요.",
          "translation": "Annie 小姐是上班族。"
        },
        {
          "speaker": "마이클",
          "korean": "대만 사람이에요.",
          "translation": "是台灣人。"
        },
        {
          "speaker": "마이클",
          "korean": "한국어를 공부해요. 중국어도 해요.",
          "translation": "她在學韓語。也會說中文。"
        },
        {
          "speaker": "마이클",
          "korean": "가족은 몇 명이에요?",
          "translation": "家裡有幾位家人？"
        },
        {
          "speaker": "애니",
          "korean": "네 명이에요.",
          "translation": "有四位。"
        }
      ]
    },
    {
      "id": "D2",
      "title": "D2 · 地鐵車廂",
      "location": "地鐵車廂",
      "context": "週一早上，유키 與 애니 在通勤的地鐵車廂裡拿出手機互看照片，聊起各自的家庭成員與人數",
      "purpose": "透過看照片確認對方家人，互相問答家人有沒有、各有幾位。",
      "turns": [
        {
          "speaker": "유키",
          "korean": "애니 씨, 사진 좀 보여 주세요.",
          "translation": "Annie，請給我看一下照片。"
        },
        {
          "speaker": "애니",
          "korean": "네, 저희 가족은 네 명이에요.",
          "translation": "好，我們家有四個人。"
        },
        {
          "speaker": "유키",
          "korean": "저도요. 오빠는 한 명 있어요.",
          "translation": "我也是。我有一位哥哥。"
        },
        {
          "speaker": "유키",
          "korean": "언니는 있어요?",
          "translation": "有姊姊嗎？"
        },
        {
          "speaker": "애니",
          "korean": "아니요, 언니는 없어요.",
          "translation": "沒有，姊姊沒有。"
        },
        {
          "speaker": "애니",
          "korean": "여동생은 한 명 있어요.",
          "translation": "有一位妹妹。"
        },
        {
          "speaker": "유키",
          "korean": "정말요? 여동생은 학생이에요?",
          "translation": "真的嗎？妹妹是學生嗎？"
        },
        {
          "speaker": "애니",
          "korean": "네, 학생이에요.",
          "translation": "對，是學生。"
        }
      ]
    },
    {
      "id": "D3",
      "title": "D3 · 飯館",
      "location": "飯館",
      "context": "晚餐時間，도현 端上餐點並與 애니 在餐桌邊看照片邊聊天。도현 介紹照片裡的親姊姊，애니 則說明自己的妹妹是學生，並預告妹妹和媽媽都會來訪",
      "purpose": "端上餐點並互相致意；看照片使用「의」指認家庭成員所屬關係；預告家人即將來訪與來訪人數。",
      "turns": [
        {
          "speaker": "도현",
          "korean": "천천히 드세요.",
          "translation": "請慢用。"
        },
        {
          "speaker": "애니",
          "korean": "잘 먹겠습니다.",
          "translation": "我要開動了。"
        },
        {
          "speaker": "애니",
          "korean": "도현 씨, 도현 씨의 누나예요?",
          "translation": "道賢先生，這是道賢先生的姊姊嗎？"
        },
        {
          "speaker": "도현",
          "korean": "네, 제 누나예요.",
          "translation": "對，是我姊姊。"
        },
        {
          "speaker": "도현",
          "korean": "애니 씨의 여동생은요?",
          "translation": "那 Annie 妳的妹妹呢？"
        },
        {
          "speaker": "애니",
          "korean": "여동생은 학생이에요. 어머니도 여동생도 와요.",
          "translation": "妹妹是學生。媽媽和妹妹都會來。"
        },
        {
          "speaker": "도현",
          "korean": "두 명이에요?",
          "translation": "是兩位嗎？"
        },
        {
          "speaker": "애니",
          "korean": "네, 두 명이에요.",
          "translation": "對，是兩位。"
        }
      ]
    }
  ],
  "article": {
    "title": "밥집〈예약 노트〉",
    "rows": [
      {
        "korean": "다음 주 토요일 예약이에요.",
        "translation": "這是下週六的預約。"
      },
      {
        "korean": "손님은 모두 네 명이에요.",
        "translation": "客人一共是四位。"
      },
      {
        "korean": "학생 세 명, 선생님 한 명이에요.",
        "translation": "是學生三位、老師一位。"
      },
      {
        "korean": "소라 선생님은 혼자 와요.",
        "translation": "Sora 老師一個人來。"
      },
      {
        "korean": "학생 세 명은 같이 와요.",
        "translation": "三位學生一起來。"
      },
      {
        "korean": "네 명 자리예요.",
        "translation": "是四個人的座位。"
      },
      {
        "korean": "하나, 둘, 셋, 넷.",
        "translation": "一、二、三、四。"
      }
    ]
  },
