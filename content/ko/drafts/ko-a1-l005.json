  "dialogue": [
    {
      "id": "D1",
      "title": "D1 · 社區公園長椅",
      "location": "社區公園長椅",
      "context": "週日下午，마이클 為了소라老師的作業在公園替애니錄製介紹影片。開拍前兩人先核對姓名、稱呼與介紹項目；隨後正式開拍，마이클 依序介紹애니的各項背景，最後在鏡頭前詢問家人人數",
      "purpose": "開拍前確認受訪者姓名與介紹重點；開拍後依序向鏡頭介紹姓名、別名、職業、國家與語言；最後完成家庭人數問答。",
      "turns": [
        {
          "speaker": "마이클",
          "korean": "잠깐만요. 이름은 뭐예요?",
          "translation": "等一下。請問名字是什麼？"
        },
        {
          "speaker": "애니",
          "korean": "천이쥔이에요. 제 별명은 애니예요.",
          "translation": "是陳怡君。我的別名是 Annie。"
        },
        {
          "speaker": "마이클",
          "korean": "직업, 나라, 언어를 소개해요?",
          "translation": "要介紹職業、國家和語言嗎？"
        },
        {
          "speaker": "애니",
          "korean": "네, 좋아요.",
          "translation": "好啊。"
        },
        {
          "speaker": "마이클",
          "korean": "안녕하세요. 이 친구는 천이쥔 씨예요.",
          "translation": "大家好。這位朋友是陳怡君小姐。"
        },
        {
          "speaker": "마이클",
          "korean": "별명은 애니예요.",
          "translation": "別名是 Annie。"
        },
        {
          "speaker": "마이클",
          "korean": "애니 씨는 회사원이에요.",
          "translation": "Annie 小姐是上班族。"
        },
        {
          "speaker": "마이클",
          "korean": "대만 사람이에요.",
          "translation": "是台灣人。"
        },
        {
          "speaker": "마이클",
          "korean": "한국어를 공부해요. 중국어도 해요.",
          "translation": "她在學韓語。也會說中文。"
        },
        {
          "speaker": "마이클",
          "korean": "가족은 몇 명이에요?",
          "translation": "家裡有幾位家人？"
        },
        {
          "speaker": "애니",
          "korean": "네 명이에요.",
          "translation": "有四位。"
        }
      ]
    }
  ],
  "article": {
    "title": "밥집〈예약 노트〉",
    "rows": [
      {
        "korean": "다음 주 토요일 예약이에요.",
        "translation": "這是下週六的預約。"
      },
      {
        "korean": "손님은 모두 네 명이에요.",
        "translation": "客人一共是四位。"
      },
      {
        "korean": "학생 세 명, 선생님 한 명이에요.",
        "translation": "是學生三位、老師一位。"
      },
      {
        "korean": "소라 선생님은 혼자 와요.",
        "translation": "Sora 老師一個人來。"
      },
      {
        "korean": "학생 세 명은 같이 와요.",
        "translation": "三位學生一起來。"
      },
      {
        "korean": "네 명 자리예요.",
        "translation": "是四個人的座位。"
      },
      {
        "korean": "하나, 둘, 셋, 넷.",
        "translation": "一、二、三、四。"
      }
    ]
  },
  "notes": [
    {
      "section": "DIALOGUE.md",
