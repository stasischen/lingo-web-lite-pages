  "dialogue": [
    {
      "id": "D1",
      "title": "D1 · 中心大門口",
      "location": "中心大門口",
      "context": "週二 18:55，下雨。소라 照名單迎接新生 애니，確認身分。",
      "purpose": "確認身分、第一次問候（本課唯一一次「안녕하세요」互答）。",
      "turns": [
        {
          "speaker": "소라",
          "korean": "안녕하세요?",
          "translation": "您好？"
        },
        {
          "speaker": "애니",
          "korean": "안녕하세요?",
          "translation": "您好？"
        },
        {
          "speaker": "소라",
          "korean": "천이쥔 씨예요?",
          "translation": "是陳怡君小姐嗎？"
        },
        {
          "speaker": "애니",
          "korean": "네. 저는 천이쥔이에요.",
          "translation": "是的。我是陳怡君。"
        },
        {
          "speaker": "소라",
          "korean": "저는 한소라예요. 선생님이에요.",
          "translation": "我是韓素拉。是老師。"
        },
        {
          "speaker": "애니",
          "korean": "네, 선생님. 저는 애니예요.",
          "translation": "好的，老師。我是 Annie。"
        }
      ]
    },
    {
      "id": "D2",
      "title": "D2 · 第一堂課教室",
      "location": "第一堂課教室",
      "context": "소라、유키、애니 在教室準備開始上課，進行自我介紹。",
      "purpose": "輪流完整自我介紹（名字、國家、職業），含「반가워요」互答（本課唯一一次）。",
      "turns": [
        {
          "speaker": "소라",
          "korean": "우리 인사해요.",
          "translation": "我們來打招呼吧。"
        },
        {
          "speaker": "유키",
          "korean": "제 이름은 사토 유키예요.",
          "translation": "我的名字是佐藤由紀。"
        },
        {
          "speaker": "유키",
          "korean": "저는 일본 사람이에요. 간호사예요.",
          "translation": "我是日本人。是護士。"
        },
        {
          "speaker": "애니",
          "korean": "반가워요, 유키 씨.",
          "translation": "很高興認識你，由紀小姐。"
        },
        {
          "speaker": "애니",
          "korean": "제 이름은 애니예요. 저는 대만 사람이에요.",
          "translation": "我的名字是 Annie。我是台灣人。"
        },
        {
          "speaker": "애니",
          "korean": "회사원이에요.",
          "translation": "是上班族。"
        },
        {
          "speaker": "유키",
          "korean": "반가워요, 애니 씨.",
          "translation": "很高興認識你，Annie 小姐。"
        }
      ]
    },
    {
      "id": "D3",
      "title": "D3 · 地鐵站出口",
      "location": "地鐵站出口",
      "context": "下課後，애니 與 유키 一起走到地鐵站出口。애니回想剛才在教室見過的소라，向유키核對身分；유키及時更正她的誤認。",
      "purpose": "애니回想剛才教室裡的소라，用名詞升調問句向유키核對身分，유키更正說明소라是老師而不是醫生。",
      "turns": [
        {
          "speaker": "애니",
          "korean": "유키 씨, 그 사람, 의사예요?",
          "translation": "由紀小姐，那個人，是醫生嗎？"
        },
        {
          "speaker": "유키",
          "korean": "아니요, 선생님이에요.",
          "translation": "不是，是老師。"
        },
        {
          "speaker": "애니",
          "korean": "소라 선생님이에요?",
          "translation": "是素拉老師嗎？"
        },
        {
          "speaker": "유키",
          "korean": "네, 소라 선생님이에요.",
          "translation": "對，是素拉老師。"
        }
      ]
    }
  ],
